{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"group": "build"
		},
		{
			"label": "test: unit",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"tests/UnitTests/UnitTests.csproj",
				"-v",
				"minimal"
			],
			"isBackground": false,
			"group": "test"
		}
	]
}