<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MothballMobile.UI.Controls.ContainerTile"
             x:Name="this">
    <ContentView.Resources>
        <x:Double x:Key="fontSize">12</x:Double>
    </ContentView.Resources>
    <Border>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="White" />
                        <Setter Property="Scale" Value="1" />
                        <Setter Property="Stroke" Value="LightGray" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="LightGray" />
                        <Setter Property="Scale" Value="0.95" />
                        <Setter Property="Stroke" Value="LightBlue" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Tapped="Border_OnTapped"
                Command="{Binding Command, Source={RelativeSource AncestorType={x:Type ContentView}}}" />
            <PointerGestureRecognizer
                PointerPressed="Border_PointerPressed"
                PointerReleased="Border_PointerReleased"
                PointerExited="Border_PointerReleased" />
        </Border.GestureRecognizers>
        <Grid Padding="5" Margin="5" RowSpacing="5" ColumnSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Row="0"
                Grid.Column="0"
                FontSize="{StaticResource fontSize}"
                Text="{Binding Name, Source={x:Reference this}}"
                VerticalOptions="Center"
                HorizontalOptions="Start" />
            <Label
                Grid.Row="0"
                Grid.Column="1"
                FontSize="{StaticResource fontSize}"
                Text="{Binding Description, Source={x:Reference this}}"
                VerticalOptions="Center"
                HorizontalOptions="Start" />
            <Label
                Grid.Row="1"
                Grid.Column="0"
                FontSize="{StaticResource fontSize}"
                Text="{Binding LocationDescription, Source={x:Reference this}}"
                VerticalOptions="Center"
                HorizontalOptions="Start" />
            <Label
                Grid.Row="1"
                Grid.Column="1"
                FontSize="{StaticResource fontSize}"
                Text="{Binding ItemCount, Source={x:Reference this}}"
                VerticalOptions="Center"
                HorizontalOptions="Start" />
            <Border Grid.RowSpan="3"
                    Grid.Column="2"
                    StrokeShape="RoundRectangle 10"
                    HorizontalOptions="Fill">
                <Image
                    Source="{Binding ImageSource}"
                    Aspect="AspectFit"/>
            </Border>
        </Grid>
    </Border>
</ContentView>
