<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MothballMobile.UI.ViewModels"
             x:Class="MothballMobile.UI.Views.AddContainer"
             Title="AddContainer">
    <VerticalStackLayout>
        <Label
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <Entry
            Placeholder="Enter container name"
            Text="{Binding Name}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <Entry
            Placeholder="Enter container description"
            Text="{Binding Description}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <Entry
            Placeholder="Enter container location"
            Text="{Binding LocationDescription}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
        <Button
            Text="Add Container"
            Command="{Binding AddContainerCommand}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>