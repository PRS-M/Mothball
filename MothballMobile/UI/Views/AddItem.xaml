<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MothballMobile.UI.Views.AddItem"
             Title="Add Item"
             BackgroundColor="#0F172A">

    <ScrollView>
        <Grid Padding="20" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
            <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,6,0,14">
                <Label Text="Add a new item" FontSize="24" FontAttributes="Bold"
                       TextColor="{StaticResource ColorPrimaryText}"/>
                <Label Text="Fill in the fields below"
                       TextColor="{StaticResource ColorMuted}"/>
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="Name" TextColor="{StaticResource ColorMuted}" Margin="4,0"/>
                    <Border Style="{StaticResource InputWrapper}" WidthRequest="{StaticResource WidthM}">
                        <Entry Style="{StaticResource Input}" Placeholder="Item name"/>
                    </Border>

                    <Label Text="Description" TextColor="{StaticResource ColorMuted}" Margin="4,8,4,0"/>
                    <Border Style="{StaticResource InputWrapper}" WidthRequest="{StaticResource WidthM}">
                        <Entry Style="{StaticResource Input}" Placeholder="Short description"/>
                    </Border>

                    <Label Text="Quantity" TextColor="{StaticResource ColorMuted}" Margin="4,8,4,0"/>
                    <Border Style="{StaticResource InputWrapper}" WidthRequest="{StaticResource WidthM}">
                        <Entry Style="{StaticResource Input}" Keyboard="Numeric" Placeholder="e.g. 1"/>
                    </Border>

                    <Button Text="Add Item" Style="{StaticResource PrimaryButton}" WidthRequest="{StaticResource WidthM}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>