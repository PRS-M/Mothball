<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MothballMobile"
             x:Class="MothballMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary xmlns:conv="clr-namespace:MothballMobile.UI.Converters">
                <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
                <Style x:Key="InvalidWrapperStyle" TargetType="Border">
                    <Setter Property="Stroke" Value="{StaticResource ColorBorder}" />
                    <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                </Style>
                <Style x:Key="ValidatedInputWrapper" TargetType="Border" BasedOn="{StaticResource InputWrapper}">
                    <Style.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding ValidationMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                                     Value="True">
                            <Setter Property="Stroke" Value="{StaticResource ColorDanger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Theme.xaml" />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
