<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:palettes="clr-namespace:MothballMobile.Resources.Styles.Palettes"
             x:Class="MothballMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary xmlns:conv="clr-namespace:MothballMobile.UI.Converters">
                <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
                <conv:LocalizedEnumConverter x:Key="LocalizedEnumConverter" />
                <Style x:Key="InvalidWrapperStyle" TargetType="Border">
                    <Setter Property="Stroke" Value="{DynamicResource OutlineVariant}" />
                    <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                </Style>
            </ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <palettes:BlueprintLedgerLight />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
