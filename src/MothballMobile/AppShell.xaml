<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MothballMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MothballMobile"
    xmlns:containers="clr-namespace:MothballMobile.UI.Features.Containers.ContainersList"
    xmlns:items="clr-namespace:MothballMobile.UI.Features.Items.ItemsList"
    Title="MothballMobile">
    <FlyoutItem Title="Home" Route="Home">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>
    <FlyoutItem Title="Containers" Route="Containers">
        <Tab Title="Containers List">
            <ShellContent
                Title="Containers List"
                ContentTemplate="{DataTemplate containers:ContainersListPage}"
                Route="ContainersList">
                <ShellContent.Icon>
                    <FontImageSource Glyph="&#xf080;" FontFamily="FontAwesomeSolid" Size="26" Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                </ShellContent.Icon>
            </ShellContent>
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Items" Route="Items">
        <Tab Title="Items List">
            <ShellContent
                Title="Items"
                ContentTemplate="{DataTemplate items:ItemsListPage}"
                Route="ItemsList">
                <ShellContent.Icon>
                    <FontImageSource Glyph="&#xf02c;" FontFamily="FontAwesomeSolid" Size="26" Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                </ShellContent.Icon>
            </ShellContent>
        </Tab>
    </FlyoutItem>
</Shell>
