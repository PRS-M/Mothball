<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MothballMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MothballMobile"
    xmlns:containers="clr-namespace:MothballMobile.UI.Features.Containers.ContainersList"
    xmlns:items="clr-namespace:MothballMobile.UI.Features.Items.ItemsList"
    xmlns:settings="clr-namespace:MothballMobile.UI.Features.Settings"
    Title="MothballMobile">
    <Shell.TitleView>
        <Border IsVisible="{Binding IsBannerVisible}"
                Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10,6"
            Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="4"
                                 WidthRequest="280">
                <Label Text="{Binding StatusText}"
                       FontSize="12"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                <ProgressBar Progress="{Binding OverallProgress}" />
            </VerticalStackLayout>
        </Border>
    </Shell.TitleView>

    <FlyoutItem Title="Home" Route="Home">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>
    <FlyoutItem Title="Containers" Route="Containers">
        <Tab Title="Containers List">
            <ShellContent
                Title="Containers List"
                ContentTemplate="{DataTemplate containers:ContainersListPage}"
                Route="ContainersList">
                <ShellContent.Icon>
                    <FontImageSource Glyph="&#xf080;" FontFamily="FontAwesomeSolid" Size="26" Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                </ShellContent.Icon>
            </ShellContent>
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Items" Route="Items">
        <Tab Title="Items List">
            <ShellContent
                Title="Items"
                ContentTemplate="{DataTemplate items:ItemsListPage}"
                Route="ItemsList">
                <ShellContent.Icon>
                    <FontImageSource Glyph="&#xf02c;" FontFamily="FontAwesomeSolid" Size="26" Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                </ShellContent.Icon>
            </ShellContent>
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Settings" Route="Settings">
        <Tab Title="Settings">
            <ShellContent
                Title="Settings"
                ContentTemplate="{DataTemplate settings:SettingsPage}"
                Route="SettingsPage">
                <ShellContent.Icon>
                    <FontImageSource Glyph="&#xf013;" FontFamily="FontAwesomeSolid" Size="26" Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                </ShellContent.Icon>
            </ShellContent>
        </Tab>
    </FlyoutItem>
</Shell>
