<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:MothballMobile.UI.Behaviors"
    x:Class="MothballMobile.Resources.Styles.AppleStyles">

    <!-- Apple-platform layer. Material semantic styles remain the Android/default layer. -->
    <Style TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="Shadow" Value="{x:Null}" />
        <Setter Property="behaviors:ButtonPill.IsEnabled" Value="False" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="TitleColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource Primary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Primary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource OnPrimary}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Primary}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="TabBar">
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource OnSurfaceVariant}" />
    </Style>

    <!-- Replace Material typography resources with platform-sized system typography. -->
    <Style TargetType="Label" x:Key="HeadlineLarge">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>

    <Style TargetType="Label" x:Key="HeadlineMedium">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.22" />
    </Style>

    <Style TargetType="Label" x:Key="HeadlineSmall">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style TargetType="Label" x:Key="TitleLarge">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style TargetType="Label" x:Key="TitleMedium">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="TitleSmall">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="BodyLarge">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="BodyMedium">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="BodySmall">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="LabelLarge">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="LabelMedium">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Label" x:Key="LabelSmall">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style TargetType="Picker" x:Key="PickerBaseStyle">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="TitleColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Picker" x:Key="CompactFilterPicker" BasedOn="{StaticResource PickerBaseStyle}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <Style TargetType="Border" x:Key="MediaCard" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="Border" x:Key="ElevatedCard" BasedOn="{StaticResource Card}" />

    <Style TargetType="Border" x:Key="SectionCard">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    </Style>

    <Style TargetType="Border" x:Key="OutlinedCard">
        <Setter Property="Stroke" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style TargetType="Border" x:Key="InputWrapper">
        <Setter Property="Stroke" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <Style TargetType="Border" x:Key="SearchWrapper" BasedOn="{StaticResource InputWrapper}">
        <Setter Property="Padding" Value="3" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <Style TargetType="Entry" x:Key="Input">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="behaviors:ButtonPill.IsEnabled" Value="False" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <Style TargetType="Button" x:Key="FilledButton" BasedOn="{StaticResource PrimaryButton}" />

    <Style TargetType="Button" x:Key="TonalButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSecondaryContainer}" />
    </Style>

    <Style TargetType="Button" x:Key="OutlinedButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Outline}" />
        <Setter Property="BorderWidth" Value="0.5" />
    </Style>

    <Style TargetType="Button" x:Key="CompactTonalButton" BasedOn="{StaticResource TonalButton}">
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style TargetType="Button" x:Key="CompactOutlinedButton" BasedOn="{StaticResource OutlinedButton}">
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style TargetType="Button" x:Key="TextButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style TargetType="Button" x:Key="DestructiveButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Error}" />
        <Setter Property="TextColor" Value="{DynamicResource OnError}" />
    </Style>

    <Style TargetType="Button" x:Key="Fab">
        <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainer}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>
</ResourceDictionary>
