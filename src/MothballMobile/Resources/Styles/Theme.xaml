<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Material Design 3 Design Tokens -->

    <!-- Spacing Scale -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="Space2Xl">32</x:Double>
    <x:Double x:Key="Space3Xl">48</x:Double>

    <!-- Shape/Border Radius -->
    <x:Double x:Key="RadiusNone">0</x:Double>
    <x:Double x:Key="RadiusXs">4</x:Double>
    <x:Double x:Key="RadiusSm">8</x:Double>
    <x:Double x:Key="RadiusMd">12</x:Double>
    <x:Double x:Key="RadiusLg">16</x:Double>
    <x:Double x:Key="RadiusXl">20</x:Double>
    <x:Double x:Key="RadiusFull">28</x:Double>

    <!-- Elevation -->
    <x:Double x:Key="Elevation0">0</x:Double>
    <x:Double x:Key="Elevation1">1</x:Double>
    <x:Double x:Key="Elevation2">3</x:Double>
    <x:Double x:Key="Elevation3">6</x:Double>
    <x:Double x:Key="Elevation4">8</x:Double>
    <x:Double x:Key="Elevation5">12</x:Double>

    <!-- Legacy theme tokens -->
    <x:Double x:Key="WidthM">320</x:Double>
    <x:Double x:Key="Radius">{StaticResource RadiusMd}</x:Double>
    <x:Double x:Key="Pad">{StaticResource SpaceLg}</x:Double>

    <!-- Semantic Color Mappings (for compatibility) -->
    <!-- Note: Use AppThemeBinding directly in styles for dynamic theming -->

    <!-- Material Design Cards -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}" Opacity="0.06" Radius="6" Offset="0,2"/>
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ElevatedCard" BasedOn="{StaticResource Card}">
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}" Opacity="0.15" Radius="12" Offset="0,4"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Material Design Inputs -->
    <Style TargetType="Border" x:Key="InputWrapper">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="4"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="SearchWrapper" BasedOn="{StaticResource InputWrapper}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"/>
        <Setter Property="StrokeThickness" Value="0.75"/>
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry" x:Key="Input">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"/>
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
        <Setter Property="ClearButtonVisibility" Value="WhileEditing"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Material Design Buttons -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="Padding" Value="24,8"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="Button" x:Key="FilledButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}" Opacity="0.15" Radius="4" Offset="0,1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="TonalButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}"/>
    </Style>

    <Style TargetType="Button" x:Key="OutlinedButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <Style TargetType="Button" x:Key="TextButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style TargetType="Button" x:Key="DestructiveButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnError}, Dark={StaticResource OnErrorDark}}"/>
    </Style>

    <!-- Material Design FAB -->
    <Style TargetType="Button" x:Key="Fab">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="WidthRequest" Value="56"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Shadow}" Opacity="0.2" Radius="8" Offset="0,4"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
