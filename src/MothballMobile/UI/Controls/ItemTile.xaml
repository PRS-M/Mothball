<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:MothballMobile.UI.Controls"
             xmlns:maui="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
             x:Class="MothballMobile.UI.Controls.ItemTile"
             x:Name="this"
             x:DataType="self:ItemTile">

    <Border Style="{StaticResource Card}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Property="Scale" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Property="Scale" Value="0.95" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Tapped="Border_OnTapped"
                Command="{Binding Source={x:Reference this}, Path=Command}" />
            <PointerGestureRecognizer
                PointerPressed="Border_PointerPressed"
                PointerReleased="Border_PointerReleased"
                PointerExited="Border_PointerReleased" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="12">
            <self:ImageCarousel
                Grid.Column="0"
                HeightRequest="{Binding Source={x:Reference this}, Path=ImageSize}"
                WidthRequest="{Binding Source={x:Reference this}, Path=ImageSize}"
                CornerRadius="{Binding Source={x:Reference this}, Path=ImageCornerRadius}"
                ImagePaths="{Binding Source={x:Reference this}, Path=ImagePaths}" />

            <Grid Grid.Column="1"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="4"
                  ColumnSpacing="8">
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Text="{Binding Source={x:Reference this}, Path=Name}"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                <Button Grid.Row="0"
                        Grid.Column="1"
                        IsVisible="{Binding Source={x:Reference this}, Path=ShowRemove}"
                        Command="{Binding Source={x:Reference this}, Path=RemoveCommand}"
                        Background="Transparent"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        ZIndex="1">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid"
                                         Glyph="&#xF00D;"
                                         Color="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                         Size="16" />
                    </Button.ImageSource>
                </Button>

                <Label Grid.Row="1"
                       Grid.ColumnSpan="2"
                       IsVisible="{Binding Source={x:Reference this}, Path=ShowQuantity}"
                       Text="{Binding Source={x:Reference this}, Path=Quantity, StringFormat='Qty: {0}'}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                       FontSize="11" />

                <Label Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Text="{Binding Source={x:Reference this}, Path=TotalQuantity, StringFormat='Total: {0}'}"
                      TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                      FontSize="11" />

                  <HorizontalStackLayout Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Spacing="12">
                      <Label Text="{Binding Source={x:Reference this}, Path=AssignedQuantity, StringFormat='Assigned: {0}'}"
                          TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                          FontSize="11" />
                      <Label Text="{Binding Source={x:Reference this}, Path=UnassignedQuantity, StringFormat='Unassigned: {0}'}"
                          TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                          FontSize="11" />
                  </HorizontalStackLayout>

                  <Label Grid.Row="4"
                       Grid.ColumnSpan="2"
                       Text="{Binding Source={x:Reference this}, Path=Description}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                       FontSize="12"
                       LineBreakMode="TailTruncation" />

                <Button Grid.Row="4"
                        Grid.Column="1"
                        Text="Edit quantity"
                        IsVisible="{Binding Source={x:Reference this}, Path=ShowEditQuantity}"
                        Command="{Binding Source={x:Reference this}, Path=EditQuantityCommand}"
                        Style="{StaticResource OutlinedButton}"
                        HeightRequest="30"
                        FontSize="11"
                        Padding="8,0"
                        HorizontalOptions="End"
                        VerticalOptions="End" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
