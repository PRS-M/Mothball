<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MothballMobile.UI.Controls.NumberPickerModalPage"
             BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24">
        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                 Opacity="0.72">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="360"
                Padding="16"
                Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="TitleLabel"
                       Style="{StaticResource HeadlineSmall}"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                  <Entry x:Name="QuantityEntry"
                      Text=""
                      Keyboard="Numeric"
                      ReturnType="Done"
                      Placeholder="Enter quantity"
                      Completed="OnEntryCompleted"
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}"
                      TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                  <Label x:Name="ValidationLabel"
                      IsVisible="False"
                      FontSize="12"
                      TextColor="{StaticResource Error}" />

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Style="{StaticResource OutlinedButton}"
                            Clicked="OnCancelClicked" />

                    <Button x:Name="AcceptButton"
                            Grid.Column="1"
                            Style="{StaticResource TonalButton}"
                            Clicked="OnAcceptClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
