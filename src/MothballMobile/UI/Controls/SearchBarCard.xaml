<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:MothballMobile.UI.Controls"
             x:Class="MothballMobile.UI.Controls.SearchBarCard"
             x:Name="this"
             x:DataType="self:SearchBarCard">

    <Border Style="{StaticResource SearchWrapper}"
            Margin="0,4">
        <SearchBar Placeholder="{Binding Source={x:Reference this}, Path=Placeholder}"
                   Text="{Binding Source={x:Reference this}, Path=Text}"
                   SearchCommand="{Binding Source={x:Reference this}, Path=SearchCommand}"
                   Background="Transparent"
                   Margin="0"
                   FontSize="14"
                   TextColor="{DynamicResource OnSurface}"
                   PlaceholderColor="{DynamicResource OnSurfaceVariant}"
                   CancelButtonColor="{DynamicResource OnSurfaceVariant}" />
    </Border>
</ContentView>
