<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:MothballMobile.UI.Controls"
             x:Class="MothballMobile.UI.Controls.SegmentedSwitch"
             x:Name="this"
             x:DataType="self:SegmentedSwitch">
    <Border Padding="4,0"
            Background="{DynamicResource PickerSurface}"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">
        <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Text="{Binding Source={x:Reference this}, Path=LeftText}"
                    Command="{Binding Source={x:Reference this}, Path=LeftCommand}"
                    Background="Transparent"
                    TextColor="{DynamicResource OnSurfaceVariant}"
                    BorderWidth="0"
                    CornerRadius="18"
                    Padding="8,0"
                    HeightRequest="36"
                    FontAttributes="Bold"
                    SemanticProperties.Hint="{Binding Source={x:Reference this}, Path=LeftText}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Source={x:Reference this}, Path=IsRightSelected}"
                                 Value="False">
                        <Setter Property="Background" Value="{DynamicResource Surface}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="{Binding Source={x:Reference this}, Path=RightText}"
                    Command="{Binding Source={x:Reference this}, Path=RightCommand}"
                    Background="Transparent"
                    TextColor="{DynamicResource OnSurfaceVariant}"
                    BorderWidth="0"
                    CornerRadius="18"
                    Padding="8,0"
                    HeightRequest="36"
                    FontAttributes="Bold"
                    SemanticProperties.Hint="{Binding Source={x:Reference this}, Path=RightText}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Source={x:Reference this}, Path=IsRightSelected}"
                                 Value="True">
                        <Setter Property="Background" Value="{DynamicResource Surface}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Border>
</ContentView>
