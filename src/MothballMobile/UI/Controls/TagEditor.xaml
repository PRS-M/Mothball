<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
             xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
             x:Class="MothballMobile.UI.Controls.TagEditor"
             x:Name="this"
             x:DataType="controls:TagEditor">
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
            <Label Text="{x:Static strings:AppResources.Tags}"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{DynamicResource OnSurface}" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Source={x:Reference this}, Path=Tags}"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Start"
                        AlignItems="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Null}">
                        <Border Background="{DynamicResource PrimaryContainer}"
                                Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1"
                                Padding="10,5"
                                Margin="0,0,8,8"
                                StrokeShape="RoundRectangle 10">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="#"
                                       TextColor="{DynamicResource OnPrimaryContainer}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding Name}"
                                       TextColor="{DynamicResource OnPrimaryContainer}"
                                       VerticalOptions="Center" />
                                <Button Padding="0"
                                        Background="Transparent"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        MinimumWidthRequest="32"
                                        MinimumHeightRequest="32"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type controls:TagEditor}}, Path=RemoveCommand}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Remove tag">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="FontAwesomeSolid"
                                                             Glyph="&#xF00D;"
                                                             Color="{DynamicResource OnPrimaryContainer}"
                                                             Size="14" />
                                        </Button.ImageSource>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Text="{Binding Source={x:Reference this}, Path=NewTagText, Mode=TwoWay}"
                       Placeholder="{x:Static strings:AppResources.TagNamePlaceholder}"
                       ClearButtonVisibility="WhileEditing"
                       ReturnType="Done"
                       ReturnCommand="{Binding Source={x:Reference this}, Path=AddCommand}" />
                <Button Grid.Column="1"
                        Text="{x:Static strings:AppResources.AddTag}"
                        Style="{StaticResource TonalButton}"
                        Command="{Binding Source={x:Reference this}, Path=AddCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF067;" Color="{DynamicResource OnSecondaryContainer}" Size="16" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <Border IsVisible="{Binding Source={x:Reference this}, Path=IsSuggestionsVisible}"
                    Background="{DynamicResource Surface}"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeThickness="1"
                    Padding="4,6"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Source={x:Reference this}, Path=SuggestedTags}"
                                     Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Null}">
                            <Border Padding="12,8"
                                    Background="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type controls:TagEditor}}, Path=SuggestionCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="32,*"
                                      ColumnSpacing="10"
                                      MinimumHeightRequest="40">
                                    <Border Background="{DynamicResource SecondaryContainer}"
                                            StrokeThickness="0"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center"
                                            StrokeShape="RoundRectangle 14">
                                        <Label Text="#"
                                               TextColor="{DynamicResource OnSecondaryContainer}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextColor="{DynamicResource OnSurface}"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Border>
</ContentView>
