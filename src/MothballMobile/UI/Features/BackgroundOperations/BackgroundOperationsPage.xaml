<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:backgroundOperations="clr-namespace:MothballMobile.Infrastructure.BackgroundOperations.Photos"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.BackgroundOperations.BackgroundOperationsPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:DataType="backgroundOperations:IPhotoBackgroundOperationTracker"
                Title="{x:Static strings:AppResources.BackgroundOperations}"
                Background="{DynamicResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{x:Static strings:AppResources.BackgroundPhotoOperations}"
                   Style="{StaticResource HeadlineSmall}"
                   TextColor="{DynamicResource OnSurface}" />

            <Border Stroke="{DynamicResource OutlineVariant}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding StatusText}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                    <ProgressBar Progress="{Binding OverallProgress}" />
                    <Label Text="{Binding ActiveOperationCount, StringFormat={x:Static strings:AppResources.ActiveOperationsFormat}}"
                           TextColor="{DynamicResource OnSurface}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static strings:AppResources.RecentOperations}"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{DynamicResource OnSurface}" />

            <CollectionView ItemsSource="{Binding RecentOperations}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Stroke="{DynamicResource OutlineVariant}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Label Text="{x:Static strings:AppResources.NoBackgroundOperationsHaveCompletedYet}"
                               TextColor="{DynamicResource OnSurfaceVariant}" />
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="backgroundOperations:PhotoBackgroundOperationEntry">
                        <Border Stroke="{DynamicResource OutlineVariant}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="4"
                                  ColumnSpacing="8">
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Description}"
                                       Style="{StaticResource BodyMedium}"
                                       TextColor="{DynamicResource OnSurface}" />

                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Succeeded, StringFormat={x:Static strings:AppResources.SuccessFormat}}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding CompletedAt, StringFormat={x:Static strings:AppResources.CompletedFormat}}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding FinalProgress, StringFormat={x:Static strings:AppResources.ProgressFormat}}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
