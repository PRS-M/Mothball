<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:backgroundOperations="clr-namespace:MothballMobile.Infrastructure.BackgroundOperations.Photos"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.BackgroundOperations.BackgroundOperationsPage"
                x:DataType="backgroundOperations:IPhotoBackgroundOperationTracker"
                Title="Background Operations"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Background photo operations"
                   Style="{StaticResource HeadlineSmall}"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

            <Border Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding StatusText}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                    <ProgressBar Progress="{Binding OverallProgress}" />
                    <Label Text="{Binding ActiveOperationCount, StringFormat='Active operations: {0}'}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Recent operations"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

            <CollectionView ItemsSource="{Binding RecentOperations}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Label Text="No background operations have completed yet."
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="backgroundOperations:PhotoBackgroundOperationEntry">
                        <Border Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="4"
                                  ColumnSpacing="8">
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Description}"
                                       Style="{StaticResource BodyMedium}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Succeeded, StringFormat='Success: {0}'}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding CompletedAt, StringFormat='Completed: {0:G}'}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding FinalProgress, StringFormat='Progress: {0:P0}'}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
