<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:local="clr-namespace:MothballMobile.UI.Features.Containers.AddContainer"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Containers.AddContainer.AddContainerPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:DataType="local:AddContainerViewModel"
                Title="{x:Static strings:AppResources.AddContainer}"
                Background="{DynamicResource Surface}">

    <Grid>
    <ScrollView>
        <Grid Padding="20"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*">
            <controls:PageHeader Grid.Row="0"
                                 Title="{x:Static strings:AppResources.CreateANewContainer}"
                                 Subtitle="Enter the details below"
                                 TitleFontSize="24"
                                 HeaderMargin="0,6,0,14" />

            <Border Grid.Row="1"
                    Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">
                    <!-- Name -->
                    <controls:ValidatedTextField Label="Name"
                                                 WidthRequest="{StaticResource WidthM}"
                                                 Placeholder="{x:Static strings:AppResources.EnterContainerName}"
                                                 Text="{Binding Name}"
                                                 ReturnType="Done"
                                                 ReturnCommand="{Binding SaveContainerCommand}"
                                                 ValidationMessage="{Binding ValidationMessage}" />

                    <!-- Notes -->
                    <controls:LabeledEntryField Label="Notes"
                                               LabelMargin="4,8,4,0"
                                               FieldWidthRequest="{StaticResource WidthM}"
                                               UseWrapper="False"
                                               Placeholder="{x:Static strings:AppResources.EnterADescriptionOrNotes}"
                                               Text="{Binding Notes}" />

                        <controls:LabeledEntryField Label="{x:Static strings:AppResources.Barcode}"
                                       LabelMargin="4,8,4,0"
                                       FieldWidthRequest="{StaticResource WidthM}"
                                       UseWrapper="False"
                                       Text="{Binding BarcodeValue}" />

                        <Grid WidthRequest="{StaticResource WidthM}"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Picker Title="{x:Static strings:AppResources.BarcodeSymbology}"
                            ItemsSource="{x:Static Member=local:AddContainerViewModel.AvailableBarcodeSymbologies}"
                            SelectedItem="{Binding BarcodeSymbology}" />
                        <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.ScanBarcode}"
                            Style="{StaticResource OutlinedButton}"
                            Command="{Binding ScanBarcodeCommand}" />
                        </Grid>

                    <!-- Temporary photo selection -->
                    <Button Text="{x:Static strings:AppResources.ChoosePhoto}"
                            Style="{StaticResource OutlinedButton}"
                            WidthRequest="{StaticResource WidthM}"
                            Command="{Binding ChoosePhotoCommand}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesomeSolid"
                                             Glyph="&#xF030;"
                                             Color="{DynamicResource Primary}"
                                             Size="16" />
                        </Button.ImageSource>
                    </Button>

                    <Border Style="{StaticResource InputWrapper}"
                            WidthRequest="{StaticResource WidthM}"
                            IsVisible="{Binding IsPhotoProcessing}">
                           <VerticalStackLayout Spacing="8"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       MinimumHeightRequest="160">
                            <ActivityIndicator IsRunning="True"
                                         WidthRequest="32"
                                         HeightRequest="32"
                                         HorizontalOptions="Center" />
                            <Label Text="{x:Static strings:AppResources.ResizingPhoto}"
                                Style="{StaticResource LabelSmall}"
                                HorizontalTextAlignment="Center" />
                           </VerticalStackLayout>
                          </Border>

                          <Border Style="{StaticResource InputWrapper}"
                            WidthRequest="{StaticResource WidthM}"
                            IsVisible="{Binding ShowPhotoThumbnail}">
                           <VerticalStackLayout Spacing="8"
                                       HorizontalOptions="Center">
                            <Image Source="{Binding PhotoThumbnailPath}"
                                HeightRequest="120"
                                WidthRequest="120"
                                Aspect="AspectFill" />
                            <Label Text="{x:Static strings:AppResources.PhotoSelected}"
                                Style="{StaticResource LabelSmall}"
                                HorizontalTextAlignment="Center" />
                           </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding PhotoSelectionStatus}"
                           Style="{StaticResource BodySmall}"
                           WidthRequest="{StaticResource WidthM}" />

                    <!-- Final entity save -->
                    <Button Text="{x:Static strings:AppResources.SaveContainer}"
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="{StaticResource WidthM}"
                            Command="{Binding SaveContainerCommand}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesomeSolid"
                                             Glyph="&#xF0C7;"
                                             Color="{DynamicResource OnPrimary}"
                                             Size="16" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
          <Grid IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{DynamicResource Primary}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</views:BasePage>
