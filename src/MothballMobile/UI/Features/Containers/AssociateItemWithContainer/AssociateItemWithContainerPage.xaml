<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Containers.AssociateItemWithContainer"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Containers.AssociateItemWithContainer.AssociateItemWithContainerPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:DataType="vm:AssociateItemWithContainerViewModel"
                Title="{x:Static strings:AppResources.SelectContainer}"
                Background="{DynamicResource Surface}">

        <Grid Padding="16"
            RowDefinitions="Auto,Auto,Auto,*"
          ColumnDefinitions="*">

          <controls:PageHeader Grid.Row="0"
                         Title="{x:Static strings:AppResources.SelectContainer}"
                         Subtitle="{x:Static strings:AppResources.TapContainerToAssociateItem}"
                         TitleFontSize="28"
                         SubtitleFontSize="14"
                         Spacing="4"
                         HeaderMargin="0,0,0,10" />

          <controls:SearchBarCard Grid.Row="1"
                          Placeholder="{x:Static strings:AppResources.SearchContainers}"
                          Text="{Binding SearchQuery}"
                          SearchCommand="{Binding ApplySearchCommand}" />

          <Button Grid.Row="2"
              Text="{x:Static strings:AppResources.ScanBarcode}"
              Style="{StaticResource OutlinedButton}"
              Margin="0,8,0,0"
              Command="{Binding ScanContainerCommand}" />

          <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Containers}"
                        Margin="0,8,0,0"
                        SelectionMode="None"
                        RemainingItemsThreshold="2"
                        RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="1"
                                 VerticalItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <controls:EmptyStateView Title="{x:Static strings:AppResources.NoContainersYet}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableContainerViewModel">
                    <controls:ContainerTile
                        Command="{Binding SelectCommand}"
                        Name="{Binding Name}"
                        Notes="{Binding Notes}"
                        ItemCount="{Binding ItemCount}"
                        ShowItemCount="{Binding ShowQuantityManagement}"
                        ImagePaths="{Binding ImagePaths}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:BasePage>
