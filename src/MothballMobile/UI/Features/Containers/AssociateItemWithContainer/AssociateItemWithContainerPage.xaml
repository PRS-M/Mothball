<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Containers.AssociateItemWithContainer"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Containers.AssociateItemWithContainer.AssociateItemWithContainerPage"
                x:DataType="vm:AssociateItemWithContainerViewModel"
                Title="Select container"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <Grid Padding="16"
          RowDefinitions="Auto,*"
          ColumnDefinitions="*">

                <controls:PageHeader Grid.Row="0"
                                                         Title="Select container"
                                                         Subtitle="Tap a container to associate this item"
                                                         TitleFontSize="28"
                                                         SubtitleFontSize="14"
                                                         Spacing="4"
                                                         HeaderMargin="0,0,0,10" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Containers}"
                        Margin="0,8,0,0"
                        SelectionMode="None"
                        RemainingItemsThreshold="2"
                        RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="1"
                                 VerticalItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <controls:EmptyStateView Title="No containers yet" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableContainerViewModel">
                    <controls:ContainerTile
                        Command="{Binding SelectCommand}"
                        Name="{Binding Name}"
                        Notes="{Binding Notes}"
                        ItemCount="{Binding ItemCount}"
                        ShowItemCount="{Binding ShowQuantityManagement}"
                        ImagePaths="{Binding ImagePaths}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:BasePage>
