<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Containers.ContainerDetails"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Containers.ContainerDetails.ContainerDetailsPage"
                x:DataType="vm:ContainerDetailsViewModel"
                Title="Container"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.Resources>
        <DataTemplate x:Key="ContainerHeaderTemplate"
                      x:DataType="vm:ContainerDetailsViewModel">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource Card}"
                        Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <controls:ImageCarousel CornerRadius="10"
                                                ShowCounter="True"
                                                UseDynamicAspectRatio="True"
                                                ImagePaths="{Binding ContainerImagePaths}" />

                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Add photo"
                                    Style="{StaticResource TonalButton}"
                                    HeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    Command="{Binding AddPhotoCommand}" />

                            <Button Text="Delete photo"
                                    Style="{StaticResource OutlinedButton}"
                                    HeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    Command="{Binding DeletePhotoCommand}" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   Style="{StaticResource TitleLarge}"/>
                            <Label Text="{Binding ItemsStoredText}"
                                   Style="{StaticResource BodyMedium}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Description"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"/>
                            <Button Grid.Column="1"
                                    Text="Edit Description"
                                    Style="{StaticResource OutlinedButton}"
                                    HeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    IsVisible="{Binding IsViewingNotes}"
                                    Command="{Binding EditNotesCommand}" />
                            <Button Grid.Column="1"
                                    Text="Save"
                                    Style="{StaticResource TonalButton}"
                                    HeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    IsVisible="{Binding IsEditingNotes}"
                                    Command="{Binding SaveNotesCommand}" />
                        </Grid>
                           <Label Text="{Binding DisplayNotes}"
                               IsVisible="{Binding IsViewingNotes}"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="8"
                                IsVisible="{Binding IsEditingNotes}">
                            <Editor Text="{Binding NotesDraft}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="96"
                                    Placeholder="Description" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Items in this container"
                           FontSize="18"
                           FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center">
                        <Button Text="Add a new item"
                                Style="{StaticResource TonalButton}"
                                HeightRequest="36"
                                FontSize="12"
                                Padding="12,0"
                                Command="{Binding NavigateToAddNewItemCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF067;"
                                                 Color="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                        <Button Text="Add an existing item"
                                Style="{StaticResource OutlinedButton}"
                                HeightRequest="36"
                                FontSize="12"
                                Padding="12,0"
                                Command="{Binding NavigateToAddExistingItemCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF067;"
                                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <controls:SearchBarCard Placeholder="Search within container..."
                                        Text="{Binding SearchQuery}"
                                        SearchCommand="{Binding ApplySearchCommand}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="ContainerItemTemplate"
                      x:DataType="vm:ItemWithPhotosViewModel">
            <controls:ItemTile Name="{Binding Name}"
                               Quantity="{Binding Quantity}"
                               TotalQuantity="{Binding TotalQuantity}"
                               AssignedQuantity="{Binding AssignedQuantity}"
                               UnassignedQuantity="{Binding UnassignedQuantity}"
                               ShowInventorySummary="{Binding ShowQuantityManagement}"
                               ShowQuantity="{Binding ShowQuantityManagement}"
                               ShowEditQuantity="{Binding ShowQuantityManagement}"
                               EditQuantityCommand="{Binding EditQuantityCommand}"
                               ShowRemove="True"
                               RemoveCommand="{Binding RemoveFromContainerCommand}"
                               Description="{Binding Description}"
                               Command="{Binding NavigateToItemDetailsCommand}"
                               ImagePaths="{Binding ImagePaths}"
                               ImageSize="92" />
        </DataTemplate>

        <vm:ContainerDetailsRowTemplateSelector x:Key="ContainerDetailsRowTemplateSelector"
                                                HeaderTemplate="{StaticResource ContainerHeaderTemplate}"
                                                ItemTemplate="{StaticResource ContainerItemTemplate}" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Priority="0"
                     Order="Primary"
                     Command="{Binding DeleteContainerCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xF1F8;"
                                 Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                 Size="22"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <CollectionView x:DataType="vm:ContainerDetailsViewModel"
                    ItemsSource="{Binding Rows}"
                    ItemTemplate="{StaticResource ContainerDetailsRowTemplateSelector}"
                    SelectionMode="None"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreItemsCommand}"
                    Margin="16"
                    VerticalScrollBarVisibility="Default">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical"
                               ItemSpacing="12"/>
        </CollectionView.ItemsLayout>

        <CollectionView.Footer>
            <controls:EmptyStateView Title="No items in this container"
                                     IsVisible="{Binding IsItemListEmpty}" />
        </CollectionView.Footer>
    </CollectionView>
</views:BasePage>
