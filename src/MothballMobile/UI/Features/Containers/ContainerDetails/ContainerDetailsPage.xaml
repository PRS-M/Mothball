<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Containers.ContainerDetails"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
                xmlns:scanning="clr-namespace:MothballMobile.UI.Features.Scanning"
                x:Class="MothballMobile.UI.Features.Containers.ContainerDetails.ContainerDetailsPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:DataType="vm:ContainerDetailsViewModel"
                Title="{x:Static strings:AppResources.Container}"
                Background="{DynamicResource Surface}">

    <ContentPage.Resources>
        <scanning:BarcodeFormatConverter x:Key="BarcodeFormatConverter" />
        <DataTemplate x:Key="ContainerHeaderTemplate"
                      x:DataType="vm:ContainerDetailsViewModel">
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource Card}"
                        Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <controls:ImageCarousel CornerRadius="10"
                                                ShowCounter="True"
                                                UseDynamicAspectRatio="True"
                                                ImagePaths="{Binding ContainerImagePaths}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="{x:Static strings:AppResources.AddPhoto}"
                                    Style="{StaticResource TonalButton}"
                                    MinimumHeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    Command="{Binding AddPhotoCommand}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid"
                                                     Glyph="&#xF030;"
                                                     Color="{DynamicResource OnSecondaryContainer}"
                                                     Size="14" />
                                </Button.ImageSource>
                            </Button>

                            <Button Grid.Column="1"
                                    Text="{x:Static strings:AppResources.DeletePhoto}"
                                    Style="{StaticResource OutlinedButton}"
                                    MinimumHeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    Command="{Binding DeletePhotoCommand}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid"
                                                     Glyph="&#xF2ED;"
                                                     Color="{DynamicResource Primary}"
                                                     Size="14" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   Style="{StaticResource TitleLarge}"/>
                            <Label Text="{Binding ItemTypesStoredText}"
                                Style="{StaticResource BodyMedium}"/>
                            <Label Text="{Binding ItemsStoredText}"
                                Style="{StaticResource BodyMedium}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                  <Border Style="{StaticResource Card}">
                      <VerticalStackLayout Spacing="8">
                      <Grid ColumnDefinitions="Auto,*,Auto"
                         ColumnSpacing="12">
                       <Label Text="{x:Static strings:AppResources.Barcode}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource OnSurface}" />
                       <Label Grid.Column="1"
                           Text="{Binding BarcodeSymbology}"
                           TextColor="{DynamicResource OnSurfaceVariant}"
                           HorizontalOptions="End" />
                       <Button Grid.Column="2"
                           Text="{x:Static strings:AppResources.EditDescription}"
                           Style="{StaticResource OutlinedButton}"
                           Command="{Binding EditBarcodeCommand}"
                           IsVisible="{Binding IsViewingBarcode}" />
                       <Button Grid.Column="2"
                           Text="{x:Static strings:AppResources.Save}"
                           Style="{StaticResource TonalButton}"
                           Command="{Binding SaveBarcodeCommand}"
                           IsVisible="{Binding IsEditingBarcode}" />
                      </Grid>
                       <Label Text="{Binding BarcodeValue}"
                           IsVisible="{Binding HasBarcode}"
                           LineBreakMode="CharacterWrap"
                           TextColor="{DynamicResource OnSurface}" />
                      <zxing:BarcodeGeneratorView IsVisible="{Binding HasBarcode}"
                          HeightRequest="116"
                          WidthRequest="240"
                          HorizontalOptions="Center"
                          ForegroundColor="{DynamicResource OnSurface}"
                          Value="{Binding BarcodeValue}"
                          Format="{Binding BarcodeSymbology, Converter={StaticResource BarcodeFormatConverter}}" />
                      <VerticalStackLayout IsVisible="{Binding IsEditingBarcode}" Spacing="8">
                       <Entry Style="{StaticResource Input}" Text="{Binding BarcodeValueDraft}" />
                       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Picker ItemsSource="{Binding AvailableBarcodeSymbologies}"
                            SelectedItem="{Binding BarcodeSymbologyDraft}" />
                        <Button Grid.Column="1" Text="{x:Static strings:AppResources.ScanBarcode}"
                            Style="{StaticResource OutlinedButton}" Command="{Binding ScanBarcodeCommand}" />
                       </Grid>
                      </VerticalStackLayout>
                      </VerticalStackLayout>
                  </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{x:Static strings:AppResources.Description}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource OnSurface}"/>
                            <Button Grid.Column="1"
                                    Text="{x:Static strings:AppResources.EditDescription}"
                                    Style="{StaticResource OutlinedButton}"
                                    MinimumHeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    IsVisible="{Binding IsViewingNotes}"
                                    Command="{Binding EditNotesCommand}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid"
                                                     Glyph="&#xF044;"
                                                     Color="{DynamicResource Primary}"
                                                     Size="14" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="1"
                                    Text="{x:Static strings:AppResources.Save}"
                                    Style="{StaticResource TonalButton}"
                                    MinimumHeightRequest="34"
                                    FontSize="12"
                                    Padding="10,0"
                                    IsVisible="{Binding IsEditingNotes}"
                                    Command="{Binding SaveNotesCommand}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid"
                                                     Glyph="&#xF0C7;"
                                                     Color="{DynamicResource OnSecondaryContainer}"
                                                     Size="14" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                           <Label Text="{Binding DisplayNotes}"
                               IsVisible="{Binding IsViewingNotes}"
                               TextColor="{DynamicResource OnSurfaceVariant}"/>
                        <Border Stroke="{DynamicResource OutlineVariant}"
                                StrokeShape="RoundRectangle 8"
                                Padding="8"
                                IsVisible="{Binding IsEditingNotes}">
                            <Editor Text="{Binding NotesDraft}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="96"
                                    Placeholder="{x:Static strings:AppResources.Description}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.ItemsInThisContainer}"
                           FontSize="18"
                           FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           TextColor="{DynamicResource OnSurface}" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8"
                          VerticalOptions="Center">
                        <Button Grid.Column="0"
                                Text="{x:Static strings:AppResources.AddANewItem}"
                                Style="{StaticResource TonalButton}"
                                MinimumHeightRequest="36"
                                FontSize="12"
                                Padding="12,0"
                                Command="{Binding NavigateToAddNewItemCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF067;"
                                                 Color="{DynamicResource OnSecondaryContainer}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                        <Button Grid.Column="1"
                                Text="{x:Static strings:AppResources.AddAnExistingItem}"
                                Style="{StaticResource OutlinedButton}"
                                MinimumHeightRequest="36"
                                FontSize="12"
                                Padding="12,0"
                                Command="{Binding NavigateToAddExistingItemCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF067;"
                                                 Color="{DynamicResource Primary}"
                                                 Size="16"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <controls:SearchBarCard Placeholder="{x:Static strings:AppResources.SearchWithinContainer}"
                                        Text="{Binding SearchQuery}"
                                        SearchCommand="{Binding ApplySearchCommand}" />
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="ContainerItemTemplate"
                      x:DataType="vm:ItemWithPhotosViewModel">
            <controls:ItemTile Name="{Binding Name}"
                               Quantity="{Binding Quantity}"
                               TotalQuantity="{Binding TotalQuantity}"
                               AssignedQuantity="{Binding AssignedQuantity}"
                               UnassignedQuantity="{Binding UnassignedQuantity}"
                               ShowInventorySummary="{Binding ShowQuantityManagement}"
                               ShowQuantity="{Binding ShowQuantityManagement}"
                               ShowEditQuantity="{Binding ShowQuantityManagement}"
                               EditQuantityCommand="{Binding EditQuantityCommand}"
                               ShowUse="{Binding ShowQuantityManagement}"
                               UseCommand="{Binding UseCommand}"
                               ShowRemove="True"
                               RemoveCommand="{Binding RemoveFromContainerCommand}"
                               Description="{Binding Description}"
                               Command="{Binding NavigateToItemDetailsCommand}"
                               ImagePaths="{Binding ImagePaths}"
                               ImageSize="92" />
        </DataTemplate>

        <vm:ContainerDetailsRowTemplateSelector x:Key="ContainerDetailsRowTemplateSelector"
                                                HeaderTemplate="{StaticResource ContainerHeaderTemplate}"
                                                ItemTemplate="{StaticResource ContainerItemTemplate}" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Priority="0"
                     Order="Primary"
                     Command="{Binding DeleteContainerCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xF1F8;"
                                 Color="{DynamicResource OnSurface}"
                                 Size="22"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
    <CollectionView x:DataType="vm:ContainerDetailsViewModel"
                    ItemsSource="{Binding Rows}"
                    ItemTemplate="{StaticResource ContainerDetailsRowTemplateSelector}"
                    SelectionMode="None"
                    RemainingItemsThreshold="3"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreItemsCommand}"
                    Margin="16"
                    VerticalScrollBarVisibility="Default">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical"
                               ItemSpacing="12"/>
        </CollectionView.ItemsLayout>

        <CollectionView.Footer>
            <Grid>
                <controls:ListLoadingView IsVisible="{Binding IsLoadingItems}"
                                          IsLoading="{Binding IsLoadingItems}"
                                          LoadingText="{x:Static strings:AppResources.LoadingContainerItems}" />
                <controls:EmptyStateView Title="{x:Static strings:AppResources.NoItemsInThisContainer}"
                                         IsVisible="{Binding IsItemListEmpty}" />
            </Grid>
        </CollectionView.Footer>
    </CollectionView>
          <Grid IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{DynamicResource Primary}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</views:BasePage>
