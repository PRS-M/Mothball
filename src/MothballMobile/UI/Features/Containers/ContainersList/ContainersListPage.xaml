<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Containers.ContainersList"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Containers.ContainersList.ContainersListPage"
                x:DataType="vm:ContainerListViewModel"
                Title="Containers"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Priority="0"
                Order="Primary"
                Command="{Binding NavigateToAddContainerCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                        Glyph="&#xF067;"
                        Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                        Size="22"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid Padding="12"
            RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <controls:PageHeader Grid.Column="0"
                                 Title="Containers"
                                 Subtitle="Browse your storage"
                                 TitleFontSize="22"
                                 SubtitleFontSize="12"
                                 Spacing="2"
                                 HeaderMargin="0,0,0,4" />

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   VerticalOptions="Center">
                <Button Text="All"
                        Command="{Binding SelectAllFilterCommand}"
                        Style="{StaticResource OutlinedButton}"
                        FontSize="12"
                        Padding="14,6"
                        HeightRequest="34">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding IsAllFilterSelected}"
                                     Value="True">
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Empty"
                        Command="{Binding SelectEmptyFilterCommand}"
                        Style="{StaticResource OutlinedButton}"
                        FontSize="12"
                        Padding="14,6"
                        HeightRequest="34">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding IsEmptyFilterSelected}"
                                     Value="True">
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </Grid>

        <controls:SearchBarCard Grid.Row="1"
                     Margin="0"
                     Placeholder="Search containers..."
                     Text="{Binding Query}"
                     SearchCommand="{Binding SearchCommand}" />

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView x:Name="ContainersCollectionView"
                            ItemsSource="{Binding Containers}"
                            Margin="0,2,0,0"
                            SelectionMode="None"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                            Span="1"
                            VerticalItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <controls:EmptyStateView Title="No containers yet"
                                 Subtitle="Tap + to add your first container"
                                 SubtitleFontSize="12" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContainerViewModel">
                        <controls:ContainerTile
                            Command="{Binding NavigateCommand}"
                            Name="{Binding Name}"
                            Notes="{Binding Notes}"
                            ItemCount="{Binding ItemCount}"
                            ImagePaths="{Binding ImagePaths}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</views:BasePage>
