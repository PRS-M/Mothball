<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Containers.ContainersList"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Containers.ContainersList.ContainersListPage"
                x:Name="ContainersPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:DataType="vm:ContainerListViewModel"
                Title="{x:Static strings:AppResources.Containers}"
                Background="{DynamicResource Surface}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.BarcodeSharing}"
                     Command="{Binding EnterSelectionModeCommand}"
                     Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Color="{DynamicResource OnSurface}" Size="22" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Priority="1"
                     Order="Primary"
                     Command="{Binding ScanToFindCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xF02A;"
                                 Color="{DynamicResource OnSurface}"
                                 Size="22" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Priority="0"
                Order="Primary"
                Command="{Binding NavigateToAddContainerCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                        Glyph="&#xF067;"
                        Color="{DynamicResource OnSurface}"
                        Size="22"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid Padding="12"
            RowDefinitions="Auto,Auto,Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <controls:PageHeader Grid.Column="0"
                                 Subtitle="{x:Static strings:AppResources.BrowseYourStorage}"
                                 TitleFontSize="22"
                                 SubtitleFontSize="14"
                                 Spacing="2"
                                 HeaderMargin="0,0,0,4" />

            <Border Grid.Column="1"
                    Padding="12,0"
                    HeightRequest="48"
                    MinimumWidthRequest="124"
                    VerticalOptions="Center"
                    Background="{DynamicResource SecondaryContainer}"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,Auto,*"
                                            ColumnSpacing="8">
                      <Label Grid.Column="0"
                          Text="&#xf0b0;"
                          FontFamily="FontAwesomeSolid"
                          FontSize="14"
                          VerticalOptions="Center"
                          TextColor="{DynamicResource OnSecondaryContainer}" />
                      <Label Text="{x:Static strings:AppResources.Filter}"
                           VerticalOptions="Center"
                           FontSize="12"
                              TextColor="{DynamicResource OnSecondaryContainer}"
                                                     Grid.Column="1" />

                                        <Picker Grid.Column="2"
                            AutomationId="ContainersFilterPicker"
                            ItemsSource="{x:Static Member=vm:ContainerListViewModel.AvailableFilters}"
                            ItemDisplayBinding="{Binding ., Converter={StaticResource LocalizedEnumConverter}}"
                            SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                            Style="{StaticResource CompactFilterPicker}" />
                </Grid>
            </Border>
        </Grid>

        <controls:TagSearchPanel Grid.Row="1"
                     Placeholder="{x:Static strings:AppResources.SearchContainers}"
                     Text="{Binding Query}"
                     SearchCommand="{Binding SearchCommand}"
                     SelectedTags="{Binding SelectedTags}"
                     SuggestedTags="{Binding SuggestedTags}"
                     IsTagSuggestionsVisible="{Binding IsTagSuggestionsVisible}"
                     AddTagCommand="{Binding AddTagCommand}"
                     RemoveTagCommand="{Binding RemoveTagCommand}" />

        <Grid Grid.Row="2"
              ColumnDefinitions="0.9*,0.9*,0.7*,1.5*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="8"
              RowSpacing="8"
              IsVisible="{Binding IsSelectionMode}">
            <HorizontalStackLayout Grid.ColumnSpan="4" Margin="4,0,0,0" Spacing="4">
                <Label Text="{x:Static strings:AppResources.NumberOfSelectedContainers}" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}" />
                <Label Text="{Binding SelectedCount}" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}" />
            </HorizontalStackLayout>
            <Button Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static strings:AppResources.All}" Padding="8,0" Style="{StaticResource OutlinedButton}" Command="{Binding SelectAllLoadedCommand}" SemanticProperties.Description="{x:Static strings:AppResources.SelectAllLoaded}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF00C;" Size="16" Color="{DynamicResource Primary}" />
                </Button.ImageSource>
            </Button>
            <Button Grid.Row="1" Grid.Column="2" Padding="8,0" Style="{StaticResource OutlinedButton}" Command="{Binding ClearSelectionCommand}" SemanticProperties.Description="{x:Static strings:AppResources.ClearSelection}">
                <Button.Text>
                    <OnPlatform x:TypeArguments="x:String" Default="{x:Static strings:AppResources.ClearSelection}">
                        <On Platform="iOS, MacCatalyst" Value="" />
                    </OnPlatform>
                </Button.Text>
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF12D;" Size="16" Color="{DynamicResource Primary}" />
                </Button.ImageSource>
            </Button>
            <Button Grid.Row="1" Grid.Column="3" Text="{x:Static strings:AppResources.ShareSelected}" MinimumWidthRequest="96" Padding="8,0" Style="{StaticResource TonalButton}" Command="{Binding ShareSelectedCommand}" IsEnabled="{Binding HasSelection}" SemanticProperties.Description="{x:Static strings:AppResources.ShareSelectedEntries}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="18" Color="{DynamicResource OnSecondaryContainer}" />
                </Button.ImageSource>
            </Button>
            <Button Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static strings:AppResources.ShareAll}" Padding="8,0" Style="{StaticResource OutlinedButton}" Command="{Binding ShareAllMatchingCommand}" SemanticProperties.Description="{x:Static strings:AppResources.ShareAllMatching}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="18" Color="{DynamicResource Primary}" />
                </Button.ImageSource>
            </Button>
            <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{x:Static strings:AppResources.Cancel}" Padding="8,0" Style="{StaticResource OutlinedButton}" Command="{Binding CancelSelectionCommand}" SemanticProperties.Description="{x:Static strings:AppResources.Cancel}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF00D;" Size="16" Color="{DynamicResource Primary}" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <Grid Grid.Row="3">
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <RefreshView.Triggers>
                    <DataTrigger TargetType="RefreshView"
                                 Binding="{Binding IsRefreshing}"
                                 Value="True">
                        <Setter Property="IsVisible"
                                Value="False" />
                    </DataTrigger>
                </RefreshView.Triggers>
                <CollectionView x:Name="ContainersCollectionView"
                                ItemsSource="{Binding Containers}"
                                Margin="0,2,0,0"
                                SelectionMode="None"
                                RemainingItemsThreshold="2"
                                RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                                         VerticalItemSpacing="16"
                                         HorizontalItemSpacing="16"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <controls:EmptyStateView Title="{x:Static strings:AppResources.NoContainersYet}"
                                     Subtitle="{x:Static strings:AppResources.TapToAddFirstContainer}"
                                     SubtitleFontSize="12" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContainerViewModel">
                            <Grid>
                                <controls:ContainerTile Command="{Binding NavigateCommand}"
                                    Name="{Binding Name}" Notes="{Binding Notes}"
                                    ItemTypesCount="{Binding ItemTypesStoredText}"
                                    ShowItemTypesCount="{Binding ShowQuantityManagement}"
                                    ItemCount="{Binding ItemsStoredText}"
                                    ImagePaths="{Binding ImagePaths}" ImageSize="125" />
                                <CheckBox IsVisible="{Binding Source={x:Reference ContainersPage}, Path=BindingContext.IsSelectionMode}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalOptions="End" VerticalOptions="Start" Margin="8" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <controls:ListLoadingView IsVisible="False"
                                      IsLoading="{Binding IsRefreshing}"
                                      LoadingText="{x:Static strings:AppResources.LoadingContainers}">
                <controls:ListLoadingView.Triggers>
                    <DataTrigger TargetType="controls:ListLoadingView"
                                 Binding="{Binding IsRefreshing}"
                                 Value="True">
                        <Setter Property="IsVisible"
                                Value="True" />
                    </DataTrigger>
                </controls:ListLoadingView.Triggers>
            </controls:ListLoadingView>
        </Grid>
    </Grid>
</views:BasePage>
