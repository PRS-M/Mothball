<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Items.AddItem"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Items.AddItem.AddItemPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:DataType="vm:AddItemViewModel"
                Title="{x:Static strings:AppResources.AddItem}"
                Background="{DynamicResource Surface}">

    <Grid>
    <ScrollView>
        <Grid Padding="20"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*">
            <controls:PageHeader Grid.Row="0"
                                 Title="{x:Static strings:AppResources.AddANewItem}"
                                 Subtitle="{x:Static strings:AppResources.FillInFieldsBelow}"
                                 TitleFontSize="24"
                                 HeaderMargin="0,6,0,14" />

            <Border Grid.Row="1"
                    Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">
                    <controls:ValidatedTextField Label="{x:Static strings:AppResources.Name}"
                                                 WidthRequest="{StaticResource WidthM}"
                                                 Placeholder="{x:Static strings:AppResources.ItemName}"
                                                 Text="{Binding Name}"
                                                 IsEnabled="{Binding IsItemMetadataEditable}"
                                                 ReturnType="Done"
                                                 ReturnCommand="{Binding SaveCommand}"
                                                 ValidationMessage="{Binding ValidationMessage}" />

                    <controls:LabeledEntryField Label="{x:Static strings:AppResources.Description}"
                                               LabelMargin="4,8,4,0"
                                               FieldWidthRequest="{StaticResource WidthM}"
                                               WrapperStyle="{StaticResource InputWrapper}"
                                               Placeholder="{x:Static strings:AppResources.ShortDescription}"
                                                                                             Text="{Binding Description}"
                                                                                             IsEnabled="{Binding IsItemMetadataEditable}" />

                        <controls:LabeledEntryField Label="{x:Static strings:AppResources.Barcode}"
                                       LabelMargin="4,8,4,0"
                                       FieldWidthRequest="{StaticResource WidthM}"
                                       WrapperStyle="{StaticResource InputWrapper}"
                                       Text="{Binding BarcodeValue}"
                                       IsEnabled="{Binding IsItemMetadataEditable}"
                                       ReturnCommand="{Binding ResolveBarcodeCommand}"
                                       UnfocusedCommand="{Binding ResolveBarcodeCommand}" />

                        <Grid WidthRequest="{StaticResource WidthM}"
                          ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="8"
                                                    IsEnabled="{Binding IsItemMetadataEditable}">
                        <Picker Title="{x:Static strings:AppResources.BarcodeSymbology}"
                            ItemsSource="{Binding AvailableBarcodeSymbologies}"
                            SelectedItem="{Binding BarcodeSymbology}" />
                        <Button Grid.Column="1"
                            Text="{x:Static strings:AppResources.ScanBarcode}"
                            Style="{StaticResource OutlinedButton}"
                            Command="{Binding ScanBarcodeCommand}" />
                        </Grid>

                            <VerticalStackLayout WidthRequest="{StaticResource WidthM}"
                                     Spacing="8"
                                     IsVisible="{Binding IsReceivingExistingItem}">
                            <Label Text="{x:Static strings:AppResources.SelectContainer}"
                                   Style="{StaticResource LabelSmall}" />
                            <Button Text="{x:Static strings:AppResources.ScanBarcode}"
                                Style="{StaticResource OutlinedButton}"
                                Command="{Binding ScanDestinationContainerCommand}" />
                            <Label Text="{Binding DestinationContainerName}"
                                   Style="{StaticResource BodySmall}"
                                   IsVisible="{Binding HasDestinationContainer}" />
                            </VerticalStackLayout>

                    <controls:LabeledEntryField Label="{x:Static strings:AppResources.Quantity}"
                                               LabelMargin="4,8,4,0"
                                               FieldWidthRequest="{StaticResource WidthM}"
                                               WrapperStyle="{StaticResource InputWrapper}"
                                               Keyboard="Numeric"
                                               Placeholder="{x:Static strings:AppResources.EG1}"
                                               Text="{Binding Quantity}"
                                               IsVisible="{Binding ShowQuantityField}" />

                    <Button Text="{x:Static strings:AppResources.ChoosePhoto}"
                            Style="{StaticResource OutlinedButton}"
                            WidthRequest="{StaticResource WidthM}"
                            Command="{Binding ChoosePhotoCommand}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesomeSolid"
                                             Glyph="&#xF030;"
                                             Color="{DynamicResource Primary}"
                                             Size="16" />
                        </Button.ImageSource>
                    </Button>

                    <Border Style="{StaticResource InputWrapper}"
                            WidthRequest="{StaticResource WidthM}"
                            IsVisible="{Binding IsPhotoProcessing}">
                           <VerticalStackLayout Spacing="8"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       MinimumHeightRequest="160">
                            <ActivityIndicator IsRunning="True"
                                         WidthRequest="32"
                                         HeightRequest="32"
                                         HorizontalOptions="Center" />
                            <Label Text="{x:Static strings:AppResources.ResizingPhoto}"
                                Style="{StaticResource LabelSmall}"
                                HorizontalTextAlignment="Center" />
                           </VerticalStackLayout>
                          </Border>

                          <Border Style="{StaticResource InputWrapper}"
                            WidthRequest="{StaticResource WidthM}"
                            IsVisible="{Binding ShowPhotoThumbnail}">
                           <VerticalStackLayout Spacing="8"
                                       HorizontalOptions="Center">
                            <Image Source="{Binding PhotoThumbnailPath}"
                                HeightRequest="120"
                                WidthRequest="120"
                                Aspect="AspectFill" />
                            <Label Text="{x:Static strings:AppResources.PhotoSelected}"
                                Style="{StaticResource LabelSmall}"
                                HorizontalTextAlignment="Center" />
                           </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding PhotoSelectionStatus}"
                           Style="{StaticResource BodySmall}"
                           WidthRequest="{StaticResource WidthM}" />

                    <Button Text="{x:Static strings:AppResources.SaveItem}"
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="{StaticResource WidthM}"
                            Command="{Binding SaveCommand}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesomeSolid"
                                             Glyph="&#xF0C7;"
                                             Color="{DynamicResource OnPrimary}"
                                             Size="16" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
          <Grid IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{DynamicResource Primary}"
                               HeightRequest="48"
                               WidthRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</views:BasePage>
