<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Items.ItemDetails"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Items.ItemDetails.ItemDetailsPage"
                x:DataType="vm:ItemDetailsViewModel"
                Title="Item"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Priority="0"
                     Order="Primary"
                     Command="{Binding DeleteItemCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xF1F8;"
                                 Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                 Size="22"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="16">
            <controls:TitleActionRow Title="{Binding Name}"
                         TitleFontSize="22"
                         TitleFontAttributes="Bold">
            <controls:TitleActionRow.Actions>
                <VerticalStackLayout Spacing="8">
                <Button Text="Go to the container"
                    Style="{StaticResource TonalButton}"
                    IsVisible="{Binding ShowGoToContainerButton}"
                    Command="{Binding NavigateToContainerCommand}"/>
                <Button Text="Associate with a container"
                    Style="{StaticResource OutlinedButton}"
                    IsVisible="{Binding HasUnassignedQuantity}"
                    Command="{Binding NavigateToAssociateWithContainerCommand}"/>
                </VerticalStackLayout>
            </controls:TitleActionRow.Actions>
            </controls:TitleActionRow>

            <Border Style="{StaticResource Card}"
                    Padding="12">
                <VerticalStackLayout Spacing="10">
                    <controls:ImageCarousel CornerRadius="10"
                                            ShowCounter="True"
                                            UseDynamicAspectRatio="True"
                                            ImagePaths="{Binding ImagePaths}" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Add photo"
                                Style="{StaticResource TonalButton}"
                                HeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                Command="{Binding AddPhotoCommand}" />

                        <Button Text="Delete photo"
                                Style="{StaticResource OutlinedButton}"
                                HeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                Command="{Binding DeletePhotoCommand}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Description"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"/>
                        <Button Grid.Column="1"
                                Text="Edit Description"
                                Style="{StaticResource OutlinedButton}"
                                HeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                IsVisible="{Binding IsViewingDescription}"
                                Command="{Binding EditDescriptionCommand}" />
                        <Button Grid.Column="1"
                                Text="Save"
                                Style="{StaticResource TonalButton}"
                                HeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                IsVisible="{Binding IsEditingDescription}"
                                Command="{Binding SaveDescriptionCommand}" />
                    </Grid>
                          <Label Text="{Binding DisplayDescription}"
                           IsVisible="{Binding IsViewingDescription}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                            StrokeShape="RoundRectangle 8"
                            Padding="8"
                            IsVisible="{Binding IsEditingDescription}">
                        <Editor Text="{Binding DescriptionDraft}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="96"
                                Placeholder="Description" />
                    </Border>
                </VerticalStackLayout>
            </Border>

                 <Border Style="{StaticResource Card}"
                         IsVisible="{Binding ShowQuantityManagement}">
                  <VerticalStackLayout Spacing="8">
                      <Label Text="Inventory"
                          FontAttributes="Bold"
                          TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                      <Grid ColumnDefinitions="*,Auto"
                         RowDefinitions="Auto,Auto,Auto"
                         RowSpacing="6">
                       <Label Text="Total quantity"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                       <Label Grid.Column="1"
                           Text="{Binding TotalQuantity}"
                           FontAttributes="Bold" />
                       <Label Grid.Row="1"
                           Text="Assigned quantity"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                       <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding AssignedQuantity}"
                           FontAttributes="Bold" />
                       <Label Grid.Row="2"
                           Text="Unassigned quantity"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                       <Label Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding UnassignedQuantity}"
                           FontAttributes="Bold" />
                      </Grid>
                      <Button Text="Set total quantity"
                              Style="{StaticResource OutlinedButton}"
                              HorizontalOptions="Start"
                              Command="{Binding SetTotalQuantityCommand}" />
                  </VerticalStackLayout>
                 </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
