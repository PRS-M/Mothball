<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Items.ItemDetails"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
                x:Class="MothballMobile.UI.Features.Items.ItemDetails.ItemDetailsPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:DataType="vm:ItemDetailsViewModel"
                Title="{x:Static strings:AppResources.Item}"
                Background="{DynamicResource Surface}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Priority="0"
                     Order="Primary"
                     Command="{Binding DeleteItemCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xF1F8;"
                                 Color="{DynamicResource OnSurface}"
                                 Size="22"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="16">
            <controls:TitleActionRow Title="{Binding Name}"
                         TitleFontSize="22"
                         TitleFontAttributes="Bold">
            <controls:TitleActionRow.Actions>
                <VerticalStackLayout Spacing="8">
                <Button Text="{x:Static strings:AppResources.GoToTheContainer}"
                    Style="{StaticResource TonalButton}"
                    IsVisible="{Binding ShowGoToContainerButton}"
                    Command="{Binding NavigateToContainerCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid"
                                         Glyph="&#xF07B;"
                                         Color="{DynamicResource OnSecondaryContainer}"
                                         Size="16" />
                    </Button.ImageSource>
                </Button>
                <Button Text="{x:Static strings:AppResources.AssociateWithAContainer}"
                    Style="{StaticResource OutlinedButton}"
                    IsVisible="{Binding HasUnassignedQuantity}"
                    Command="{Binding NavigateToAssociateWithContainerCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid"
                                         Glyph="&#xF0C1;"
                                         Color="{DynamicResource Primary}"
                                         Size="16" />
                    </Button.ImageSource>
                </Button>
                </VerticalStackLayout>
            </controls:TitleActionRow.Actions>
            </controls:TitleActionRow>

            <Border Style="{StaticResource Card}"
                    Padding="12">
                <VerticalStackLayout Spacing="10">
                    <controls:ImageCarousel CornerRadius="10"
                                            ShowCounter="True"
                                            UseDynamicAspectRatio="True"
                                            ImagePaths="{Binding ImagePaths}" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="{x:Static strings:AppResources.AddPhoto}"
                                Style="{StaticResource TonalButton}"
                                MinimumHeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                Command="{Binding AddPhotoCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF030;"
                                                 Color="{DynamicResource OnSecondaryContainer}"
                                                 Size="14" />
                            </Button.ImageSource>
                        </Button>

                        <Button Grid.Column="1"
                                Text="{x:Static strings:AppResources.DeletePhoto}"
                                Style="{StaticResource OutlinedButton}"
                                MinimumHeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                Command="{Binding DeletePhotoCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF2ED;"
                                                 Color="{DynamicResource Primary}"
                                                 Size="14" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                </VerticalStackLayout>
            </Border>

                 <Border Style="{StaticResource Card}">
                  <VerticalStackLayout Spacing="8">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                     ColumnSpacing="12">
                      <Label Text="{x:Static strings:AppResources.Barcode}"
                          FontAttributes="Bold"
                          TextColor="{DynamicResource OnSurface}" />
                      <Label Grid.Column="1"
                          Text="{Binding BarcodeSymbology}"
                          TextColor="{DynamicResource OnSurfaceVariant}"
                          HorizontalOptions="End" />
                      <Button Grid.Column="2" Text="{x:Static strings:AppResources.EditDescription}"
                          Style="{StaticResource OutlinedButton}" Command="{Binding EditBarcodeCommand}"
                          IsVisible="{Binding IsViewingBarcode}" />
                      <Button Grid.Column="2" Text="{x:Static strings:AppResources.Save}"
                          Style="{StaticResource TonalButton}" Command="{Binding SaveBarcodeCommand}"
                          IsVisible="{Binding IsEditingBarcode}" />
                  </Grid>
                      <Label Text="{Binding BarcodeValue}"
                          IsVisible="{Binding HasBarcode}"
                          LineBreakMode="CharacterWrap"
                          TextColor="{DynamicResource OnSurface}" />
                  <zxing:BarcodeGeneratorView IsVisible="{Binding HasBarcode}"
                      HeightRequest="116"
                      WidthRequest="240"
                      HorizontalOptions="Center"
                      ForegroundColor="{DynamicResource OnSurface}"
                      Value="{Binding BarcodeValue}"
                      Format="{Binding BarcodeSymbology}" />
                  <VerticalStackLayout IsVisible="{Binding IsEditingBarcode}" Spacing="8">
                      <Entry Style="{StaticResource Input}" Text="{Binding BarcodeValueDraft}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <Picker ItemsSource="{x:Static Member=vm:ItemDetailsViewModel.AvailableBarcodeSymbologies}"
                              SelectedItem="{Binding BarcodeSymbologyDraft}" />
                          <Button Grid.Column="1" Text="{x:Static strings:AppResources.ScanBarcode}"
                              Style="{StaticResource OutlinedButton}" Command="{Binding ScanBarcodeCommand}" />
                      </Grid>
                  </VerticalStackLayout>
                  </VerticalStackLayout>
                 </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static strings:AppResources.Description}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource OnSurface}"/>
                        <Button Grid.Column="1"
                                Text="{x:Static strings:AppResources.EditDescription}"
                                Style="{StaticResource OutlinedButton}"
                                MinimumHeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                IsVisible="{Binding IsViewingDescription}"
                                Command="{Binding EditDescriptionCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF044;"
                                                 Color="{DynamicResource Primary}"
                                                 Size="14" />
                            </Button.ImageSource>
                        </Button>
                        <Button Grid.Column="1"
                                Text="{x:Static strings:AppResources.Save}"
                                Style="{StaticResource TonalButton}"
                                MinimumHeightRequest="34"
                                FontSize="12"
                                Padding="10,0"
                                IsVisible="{Binding IsEditingDescription}"
                                Command="{Binding SaveDescriptionCommand}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid"
                                                 Glyph="&#xF0C7;"
                                                 Color="{DynamicResource OnSecondaryContainer}"
                                                 Size="14" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                          <Label Text="{Binding DisplayDescription}"
                           IsVisible="{Binding IsViewingDescription}"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                    <Border Stroke="{DynamicResource OutlineVariant}"
                            StrokeShape="RoundRectangle 8"
                            Padding="8"
                            IsVisible="{Binding IsEditingDescription}">
                        <Editor Text="{Binding DescriptionDraft}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="96"
                                Placeholder="{x:Static strings:AppResources.Description}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

                 <Border Style="{StaticResource Card}"
                         IsVisible="{Binding ShowQuantityManagement}">
                  <VerticalStackLayout Spacing="8">
                      <Label Text="{x:Static strings:AppResources.Inventory}"
                          FontAttributes="Bold"
                          TextColor="{DynamicResource OnSurface}" />
                      <Grid ColumnDefinitions="*,Auto"
                         RowDefinitions="Auto,Auto,Auto"
                         RowSpacing="6">
                       <Label Text="{x:Static strings:AppResources.TotalQuantity}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                       <Label Grid.Column="1"
                           Text="{Binding TotalQuantity}"
                           FontAttributes="Bold" />
                       <Label Grid.Row="1"
                           Text="{x:Static strings:AppResources.AssignedQuantity}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                       <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding AssignedQuantity}"
                           FontAttributes="Bold" />
                       <Label Grid.Row="2"
                           Text="{x:Static strings:AppResources.UnassignedQuantity}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                       <Label Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding UnassignedQuantity}"
                           FontAttributes="Bold" />
                      </Grid>
                      <HorizontalStackLayout Spacing="8"
                                             HorizontalOptions="End">
                          <Button Text="{x:Static strings:AppResources.EditQuantity}"
                                  Style="{StaticResource OutlinedButton}"
                                  Command="{Binding EditQuantityCommand}">
                              <Button.ImageSource>
                                  <FontImageSource FontFamily="FontAwesomeSolid"
                                                   Glyph="&#xF1EC;"
                                                   Color="{DynamicResource Primary}"
                                                   Size="16" />
                              </Button.ImageSource>
                          </Button>
                          <Button Text="{x:Static strings:AppResources.Use}"
                                  Style="{StaticResource OutlinedButton}"
                                  Command="{Binding UseCommand}">
                              <Button.ImageSource>
                                  <FontImageSource FontFamily="FontAwesomeSolid"
                                                   Glyph="&#xF2ED;"
                                                   Color="{DynamicResource Primary}"
                                                   Size="16" />
                              </Button.ImageSource>
                          </Button>
                      </HorizontalStackLayout>
                  </VerticalStackLayout>
                 </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
