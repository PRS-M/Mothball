<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                xmlns:local="clr-namespace:MothballMobile.UI.Features.Scanning"
                xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:Class="MothballMobile.UI.Features.Scanning.BarcodeScannerPage"
                x:DataType="local:BarcodeScannerViewModel"
                Title="{x:Static strings:AppResources.BarcodeScannerTitle}"
                Background="{DynamicResource Surface}">
    <Grid RowDefinitions="*,Auto"
            Padding="16">
         <zxing:CameraBarcodeReaderView x:Name="barcodeReader"
                                            BarcodesDetected="OnBarcodesDetected" />
         <Label x:Name="cameraUnsupportedMessage"
                 IsVisible="False"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"
                 HorizontalTextAlignment="Center"
                 Text="{x:Static strings:AppResources.CameraBarcodeScanningUnavailable}"
                 TextColor="{DynamicResource OnSurfaceVariant}" />
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="12"
              Margin="0,16,0,0">
            <Button Text="{x:Static strings:AppResources.Torch}"
                    Style="{StaticResource OutlinedButton}"
                    Clicked="OnTorchClicked" />
            <Button Grid.Column="1"
                    Text="{x:Static strings:AppResources.Gallery}"
                    Style="{StaticResource OutlinedButton}"
                    Clicked="OnGalleryClicked" />
            <Button Grid.Column="2"
                    Text="{x:Static strings:AppResources.Cancel}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CancelCommand}" />
        </Grid>
                <Grid Grid.RowSpan="2"
                          BackgroundColor="#80000000"
                          IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                                           Color="{DynamicResource Primary}"
                                                           HeightRequest="48"
                                                           WidthRequest="48"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                </Grid>
    </Grid>
</views:BasePage>