<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Settings.ImportDocumentationPage"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                Title="{x:Static strings:AppResources.DocumentationHelp}"
                Background="{DynamicResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <controls:PageHeader Title="{x:Static strings:AppResources.DocumentationHelp}"
                                 Subtitle="Backup import modes"
                                 TitleFontSize="22"
                                 SubtitleFontSize="12"
                                 Spacing="2"
                                 HeaderMargin="0,0,0,6" />

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.ChoosingAnImportMode}"
                           Style="{StaticResource HeadlineSmall}"
                           TextColor="{DynamicResource OnSurface}" />

                    <Label Text="{x:Static strings:AppResources.ImportModesControlHowRecordsAlreadyInTheAppAreHandledWhenABackupJSONFileIsRestoredChooseTheLeastDestructiveModeThatMatchesWhatYouNeed}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.AddOnly}"
                           Style="{StaticResource TitleMedium}"
                           TextColor="{DynamicResource OnSurface}" />

                    <Label Text="{x:Static strings:AppResources.AddsContainersItemsRelationQuantityDeltasAndImagesThatArePresentInTheBackupButMissingFromTheApp}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Label Text="{x:Static strings:AppResources.ExistingContainersItemsRelationsAndImagesAreLeftUnchangedThisIsTheSafestChoiceWhenYouWantToMergeABackupWithoutModifyingCurrentData}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.AddUpsertMetadata}"
                           Style="{StaticResource TitleMedium}"
                           TextColor="{DynamicResource OnSurface}" />

                    <Label Text="{x:Static strings:AppResources.AddsMissingRecordsJustLikeAddOnly}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Label Text="{x:Static strings:AppResources.ForExistingContainersItUpdatesNameAndNotesWhenTheBackupDiffersForExistingItemsItUpdatesNameAndDescriptionWhenTheBackupDiffers}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Label Text="{x:Static strings:AppResources.RelationsAndImageReferencesRemainAdditiveForExistingRecords}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.FullSyncRoots}"
                           Style="{StaticResource TitleMedium}"
                           TextColor="{DynamicResource OnSurface}" />

                    <Label Text="{x:Static strings:AppResources.IncludesAddUpsertMetadataBehavior}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Label Text="{x:Static strings:AppResources.DeletesContainersAndItemsThatExistInTheAppButAreNotPresentInTheBackupThisMakesTheTopLevelInventoryMatchTheBackup}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Label Text="{x:Static strings:AppResources.ForSurvivingContainersAndItemsRelationAndImageRestoreRemainsAdditiveMissingRelationQuantitiesAndImageReferencesAreAddedButOmittedRelationPairsAndImageReferencesAreNotRemoved}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.StrictFullSync}"
                           Style="{StaticResource TitleMedium}"
                           TextColor="{DynamicResource OnSurface}" />

                    <Label Text="{x:Static strings:AppResources.IncludesFullSyncRootBehaviorIncludingDeletionOfContainersAndItemsThatAreNotInTheBackup}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Label Text="{x:Static strings:AppResources.ForSurvivingRelationPairsTheAppIsReconciledToTheBackupExactlyMissingPairsAreInsertedExtraPairsAreDeletedAndExistingPairQuantitiesAreSetToTheBackupQuantity}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Label Text="{x:Static strings:AppResources.ForSurvivingImageReferencesMissingOwnerImageReferencesAreInsertedAndExtraOwnerImageReferencesAreDeleted}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
