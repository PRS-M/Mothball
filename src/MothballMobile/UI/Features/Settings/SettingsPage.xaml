<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Settings"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Settings.SettingsPage"
                x:DataType="vm:SettingsViewModel"
                Title="Settings"
                Background="{DynamicResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <controls:PageHeader Title="Settings"
                                 Subtitle="Maintenance and backup"
                                 TitleFontSize="22"
                                 SubtitleFontSize="12"
                                 Spacing="2"
                                 HeaderMargin="0,0,0,6" />

                        <Border Padding="14"
                                        StrokeThickness="1"
                                        Stroke="{DynamicResource OutlineVariant}"
                                        StrokeShape="RoundRectangle 16"
                                        Background="{DynamicResource SurfaceVariant}">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="Theme Mode"
                                                   Style="{StaticResource HeadlineSmall}"
                                                   TextColor="{DynamicResource OnSurface}" />

                                        <Picker Title="Theme Mode"
                                                        ItemsSource="{Binding Appearance.ModeOptions}"
                                                        SelectedItem="{Binding Appearance.SelectedModeOption, Mode=TwoWay}"
                                                        SemanticProperties.Hint="Choose automatic system theme, light theme, or dark theme" />

                                        <Label Text="Choose whether Mothball follows the system appearance or always uses a light or dark mode."
                                                   Style="{StaticResource BodyMedium}"
                                                   TextColor="{DynamicResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                        </Border>

                        <Border Padding="14"
                                        StrokeThickness="1"
                                        Stroke="{DynamicResource OutlineVariant}"
                                        StrokeShape="RoundRectangle 16"
                                        Background="{DynamicResource SurfaceVariant}">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="Theme"
                                                   Style="{StaticResource HeadlineSmall}"
                                                   TextColor="{DynamicResource OnSurface}" />
                                        <Picker Title="Theme"
                                                        ItemsSource="{Binding Appearance.ThemeOptions}"
                                                        SelectedItem="{Binding Appearance.SelectedThemeOption, Mode=TwoWay}"
                                                        SemanticProperties.Hint="Choose the Mothball color theme" />
                                        <Label Text="Choose the color palette used throughout Mothball."
                                                   Style="{StaticResource BodyMedium}"
                                                   TextColor="{DynamicResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                        </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeShape="RoundRectangle 16"
                    Background="{DynamicResource SurfaceVariant}">
                <VerticalStackLayout Spacing="10">
                      <Label Text="App mode"
                              Style="{StaticResource HeadlineSmall}"
                              TextColor="{DynamicResource OnSurface}" />

                      <controls:SegmentedSwitch LeftText="Simple"
                                                    RightText="Advanced"
                                                    IsRightSelected="{Binding Appearance.IsAdvancedAppMode, Mode=TwoWay}"
                                                    LeftCommand="{Binding Appearance.SelectSimpleAppModeCommand}"
                                                    RightCommand="{Binding Appearance.SelectAdvancedAppModeCommand}"
                                                      HorizontalOptions="Fill"
                                                    SemanticProperties.Hint="Switch between simple mode and advanced mode" />

                    <Label Text="Advanced mode shows quantity totals, assignments, and quantity editing. Simple mode hides quantity management."
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

             <Border Padding="14"
                      StrokeThickness="1"
                      Stroke="{DynamicResource OutlineVariant}"
                      StrokeShape="RoundRectangle 16"
                      Background="{DynamicResource SurfaceVariant}">
                  <VerticalStackLayout Spacing="10">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                          <Label Text="Backup signing key"
                                 Style="{StaticResource HeadlineSmall}"
                                 VerticalOptions="Center"
                                 TextColor="{DynamicResource OnSurface}" />
                          <Switch Grid.Column="1"
                                  IsToggled="{Binding SigningKey.IsBackupSigningKeyEnabled, Mode=TwoWay}"
                                  SemanticProperties.Hint="Enable or disable backup signing key use" />
                      </Grid>

                    <Label Text="When enabled, backups are signed with this device key. Share or import it to verify backups across devices."
                              Style="{StaticResource BodyMedium}"
                              TextColor="{DynamicResource OnSurfaceVariant}" />

                      <Button Text="Share signing key"
                                IsEnabled="{Binding SigningKey.IsBackupSigningKeyEnabled}"
                                Command="{Binding SigningKey.ShareBackupSigningKeyCommand}"
                                                                                                                                SemanticProperties.Hint="Share the backup signing key using the system share sheet, including AirDrop">
                                                                                                <Button.ImageSource>
                                                                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                                                                </Button.ImageSource>
                                                                                        </Button>

                    <Button Text="Import signing key"
                            Style="{StaticResource OutlinedButton}"
                            IsEnabled="{Binding SigningKey.IsBackupSigningKeyEnabled}"
                            Command="{Binding SigningKey.ImportBackupSigningKeyCommand}"
                                                        SemanticProperties.Hint="Import a backup signing key file received from another device">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                         Color="{DynamicResource Primary}" />
                                                </Button.ImageSource>
                                        </Button>
                  </VerticalStackLayout>
             </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeShape="RoundRectangle 16"
                    Background="{DynamicResource SurfaceVariant}">
                <VerticalStackLayout Spacing="10">
                      <Label Text="Backup"
                              Style="{StaticResource HeadlineSmall}"
                              TextColor="{DynamicResource OnSurface}" />

                    <controls:SegmentedSwitch LeftText="JSON"
                                                    RightText="ZIP"
                                                    IsRightSelected="{Binding Backup.IsZipBackupMode, Mode=TwoWay}"
                                                    LeftCommand="{Binding Backup.SelectJsonBackupModeCommand}"
                                                    RightCommand="{Binding Backup.SelectZipBackupModeCommand}"
                                                      HorizontalOptions="Fill"
                                                    VerticalOptions="Center" />

                    <Label Text="Export inventory metadata as JSON, or create a ZIP backup that also includes photo files."
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Button Text="Documentation / Help"
                            Style="{StaticResource OutlinedButton}"
                            Command="{Binding Backup.NavigateToImportDocumentationCommand}"
                                                        SemanticProperties.Hint="Open documentation that explains backup import modes">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF02D;" Size="16"
                                                                                         Color="{DynamicResource Primary}" />
                                                </Button.ImageSource>
                                        </Button>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding Backup.IsJsonBackupMode}">
                        <Button Text="Export to JSON"
                                Command="{Binding Backup.ExportToJsonCommand}"
                                                                SemanticProperties.Hint="Create a local backup JSON file with full inventory data">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF019;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import from JSON"
                                Command="{Binding Backup.ImportFromJsonCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a local backup JSON file">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import from JSON from files"
                                Command="{Binding Backup.ImportJsonFromFileSystemCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a JSON backup from the file system">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF15B;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Share backup JSON"
                                Command="{Binding Backup.ShareJsonCommand}"
                                                                SemanticProperties.Hint="Choose and share a local backup JSON file outside the app">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Delete backup JSON"
                                Command="{Binding Backup.DeleteJsonCommand}"
                                                                SemanticProperties.Hint="Choose and delete a local backup JSON file">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF2ED;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding Backup.IsZipBackupMode}">
                        <Button Text="Export with photos to ZIP"
                                Command="{Binding Backup.ExportToZipCommand}"
                                                                SemanticProperties.Hint="Create a local ZIP backup with inventory data and photo files">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF019;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import with photos from ZIP"
                                Command="{Binding Backup.ImportFromZipCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a local ZIP backup with photo files">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import from ZIP from files"
                                Command="{Binding Backup.ImportZipFromFileSystemCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a ZIP backup from the file system">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF15B;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Share backup ZIP"
                                Command="{Binding Backup.ShareZipCommand}"
                                                                SemanticProperties.Hint="Choose and share a local backup ZIP file outside the app">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Delete backup ZIP"
                                Command="{Binding Backup.DeleteZipCommand}"
                                                                SemanticProperties.Hint="Choose and delete a local backup ZIP file">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF2ED;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding Backup.IsBusy}"
                                       IsVisible="{Binding Backup.IsBusy}"
                                       HorizontalOptions="Start"
                                       Color="{DynamicResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeShape="RoundRectangle 16"
                    Background="{DynamicResource SurfaceVariant}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Image processing"
                           Style="{StaticResource HeadlineSmall}"
                           TextColor="{DynamicResource OnSurface}" />

                    <Label Text="View active and recent background photo operations."
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Button Text="View image processing"
                            Command="{Binding NavigateToBackgroundOperationsCommand}"
                                                        SemanticProperties.Hint="Open the background photo operations page">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1C5;" Size="16"
                                                                                         Color="{DynamicResource OnPrimary}" />
                                                </Button.ImageSource>
                                        </Button>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
