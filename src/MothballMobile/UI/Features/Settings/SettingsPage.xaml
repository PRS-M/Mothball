<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Settings"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                xmlns:strings="clr-namespace:MothballMobile.Resources.Localization"
                x:Class="MothballMobile.UI.Features.Settings.SettingsPage"
                x:DataType="vm:SettingsViewModel"
                Title="{x:Static strings:AppResources.Settings}"
                Background="{DynamicResource Surface}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <controls:PageHeader Title="{x:Static strings:AppResources.Settings}"
                                 Subtitle="Maintenance and backup"
                                 TitleFontSize="22"
                                 SubtitleFontSize="12"
                                 Spacing="2"
                                 HeaderMargin="0,0,0,6" />

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeShape="RoundRectangle 16"
                    Background="{DynamicResource SurfaceVariant}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static strings:AppResources.Language}"
                           Style="{StaticResource HeadlineSmall}"
                           TextColor="{DynamicResource OnSurface}" />
                    <Picker Title="{x:Static strings:AppResources.Language}"
                            ItemsSource="{Binding Appearance.LanguageOptions}"
                            SelectedItem="{Binding Appearance.SelectedLanguageOption, Mode=TwoWay}"
                            SemanticProperties.Hint="{x:Static strings:AppResources.ChooseApplicationLanguage}" />
                    <Label Text="{x:Static strings:AppResources.RestartMothballToApplyTheNewLanguage}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

                        <Border Padding="14"
                                        StrokeThickness="1"
                                        Stroke="{DynamicResource OutlineVariant}"
                                        StrokeShape="RoundRectangle 16"
                                        Background="{DynamicResource SurfaceVariant}">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="{x:Static strings:AppResources.ThemeMode}"
                                                   Style="{StaticResource HeadlineSmall}"
                                                   TextColor="{DynamicResource OnSurface}" />

                                        <Picker Title="{x:Static strings:AppResources.ThemeMode}"
                                                        ItemsSource="{Binding Appearance.ModeOptions}"
                                                        SelectedItem="{Binding Appearance.SelectedModeOption, Mode=TwoWay}"
                                                        SemanticProperties.Hint="{x:Static strings:AppResources.ChooseAutomaticSystemThemeLightThemeOrDarkTheme}" />

                                        <Label Text="{x:Static strings:AppResources.ChooseWhetherMothballFollowsTheSystemAppearanceOrAlwaysUsesALightOrDarkMode}"
                                                   Style="{StaticResource BodyMedium}"
                                                   TextColor="{DynamicResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                        </Border>

                        <Border Padding="14"
                                        StrokeThickness="1"
                                        Stroke="{DynamicResource OutlineVariant}"
                                        StrokeShape="RoundRectangle 16"
                                        Background="{DynamicResource SurfaceVariant}">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="{x:Static strings:AppResources.Theme}"
                                                   Style="{StaticResource HeadlineSmall}"
                                                   TextColor="{DynamicResource OnSurface}" />
                                        <Picker Title="{x:Static strings:AppResources.Theme}"
                                                        ItemsSource="{Binding Appearance.ThemeOptions}"
                                                        SelectedItem="{Binding Appearance.SelectedThemeOption, Mode=TwoWay}"
                                                        SemanticProperties.Hint="{x:Static strings:AppResources.ChooseTheMothballColorTheme}" />
                                        <Label Text="{x:Static strings:AppResources.ChooseTheColorPaletteUsedThroughoutMothball}"
                                                   Style="{StaticResource BodyMedium}"
                                                   TextColor="{DynamicResource OnSurfaceVariant}" />
                                </VerticalStackLayout>
                        </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeShape="RoundRectangle 16"
                    Background="{DynamicResource SurfaceVariant}">
                <VerticalStackLayout Spacing="10">
                      <Label Text="{x:Static strings:AppResources.AppMode}"
                              Style="{StaticResource HeadlineSmall}"
                              TextColor="{DynamicResource OnSurface}" />

                      <controls:SegmentedSwitch LeftText="{x:Static strings:AppResources.Simple}"
                                                    RightText="{x:Static strings:AppResources.Advanced}"
                                                    IsRightSelected="{Binding Appearance.IsAdvancedAppMode, Mode=TwoWay}"
                                                    LeftCommand="{Binding Appearance.SelectSimpleAppModeCommand}"
                                                    RightCommand="{Binding Appearance.SelectAdvancedAppModeCommand}"
                                                      HorizontalOptions="Fill"
                                                    SemanticProperties.Hint="{x:Static strings:AppResources.SwitchBetweenSimpleModeAndAdvancedMode}" />

                    <Label Text="{x:Static strings:AppResources.AdvancedModeShowsQuantityTotalsAssignmentsAndQuantityEditingSimpleModeHidesQuantityManagement}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

             <Border Padding="14"
                      StrokeThickness="1"
                      Stroke="{DynamicResource OutlineVariant}"
                      StrokeShape="RoundRectangle 16"
                      Background="{DynamicResource SurfaceVariant}">
                  <VerticalStackLayout Spacing="10">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                          <Label Text="{x:Static strings:AppResources.BackupSigningKey}"
                                 Style="{StaticResource HeadlineSmall}"
                                 VerticalOptions="Center"
                                 TextColor="{DynamicResource OnSurface}" />
                          <Switch Grid.Column="1"
                                  IsToggled="{Binding SigningKey.IsBackupSigningKeyEnabled, Mode=TwoWay}"
                                  SemanticProperties.Hint="{x:Static strings:AppResources.EnableOrDisableBackupSigningKeyUse}" />
                      </Grid>

                    <Label Text="{x:Static strings:AppResources.WhenEnabledBackupsAreSignedWithThisDeviceKeyShareOrImportItToVerifyBackupsAcrossDevices}"
                              Style="{StaticResource BodyMedium}"
                              TextColor="{DynamicResource OnSurfaceVariant}" />

                      <Button Text="{x:Static strings:AppResources.ShareSigningKey}"
                                IsEnabled="{Binding SigningKey.IsBackupSigningKeyEnabled}"
                                Command="{Binding SigningKey.ShareBackupSigningKeyCommand}"
                                                                                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ShareTheBackupSigningKeyUsingTheSystemShareSheetIncludingAirDrop}">
                                                                                                <Button.ImageSource>
                                                                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                                                                </Button.ImageSource>
                                                                                        </Button>

                    <Button Text="{x:Static strings:AppResources.ImportSigningKey}"
                            Style="{StaticResource OutlinedButton}"
                            IsEnabled="{Binding SigningKey.IsBackupSigningKeyEnabled}"
                            Command="{Binding SigningKey.ImportBackupSigningKeyCommand}"
                                                        SemanticProperties.Hint="{x:Static strings:AppResources.ImportABackupSigningKeyFileReceivedFromAnotherDevice}">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                         Color="{DynamicResource Primary}" />
                                                </Button.ImageSource>
                                        </Button>
                  </VerticalStackLayout>
             </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeShape="RoundRectangle 16"
                    Background="{DynamicResource SurfaceVariant}">
                <VerticalStackLayout Spacing="10">
                      <Label Text="{x:Static strings:AppResources.Backup}"
                              Style="{StaticResource HeadlineSmall}"
                              TextColor="{DynamicResource OnSurface}" />

                    <controls:SegmentedSwitch LeftText="{x:Static strings:AppResources.JSON}"
                                                    RightText="{x:Static strings:AppResources.ZIP}"
                                                    IsRightSelected="{Binding Backup.IsZipBackupMode, Mode=TwoWay}"
                                                    LeftCommand="{Binding Backup.SelectJsonBackupModeCommand}"
                                                    RightCommand="{Binding Backup.SelectZipBackupModeCommand}"
                                                      HorizontalOptions="Fill"
                                                    VerticalOptions="Center" />

                    <Label Text="{x:Static strings:AppResources.ExportInventoryMetadataAsJSONOrCreateAZIPBackupThatAlsoIncludesPhotoFiles}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Button Text="{x:Static strings:AppResources.DocumentationHelp}"
                            Style="{StaticResource OutlinedButton}"
                            Command="{Binding Backup.NavigateToImportDocumentationCommand}"
                                                        SemanticProperties.Hint="{x:Static strings:AppResources.OpenDocumentationThatExplainsBackupImportModes}">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF02D;" Size="16"
                                                                                         Color="{DynamicResource Primary}" />
                                                </Button.ImageSource>
                                        </Button>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding Backup.IsJsonBackupMode}">
                        <Button Text="{x:Static strings:AppResources.ExportToJSON}"
                                Command="{Binding Backup.ExportToJsonCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.CreateALocalBackupJSONFileWithFullInventoryData}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF019;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.ImportFromJSON}"
                                Command="{Binding Backup.ImportFromJsonCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseRestoreModeAndImportALocalBackupJSONFile}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.ImportFromJSONFromFiles}"
                                Command="{Binding Backup.ImportJsonFromFileSystemCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseRestoreModeAndImportAJSONBackupFromTheFileSystem}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF15B;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.ShareBackupJSON}"
                                Command="{Binding Backup.ShareJsonCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseAndShareALocalBackupJSONFileOutsideTheApp}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.DeleteBackupJSON}"
                                Command="{Binding Backup.DeleteJsonCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseAndDeleteALocalBackupJSONFile}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF2ED;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding Backup.IsZipBackupMode}">
                        <Button Text="{x:Static strings:AppResources.ExportWithPhotosToZIP}"
                                Command="{Binding Backup.ExportToZipCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.CreateALocalZIPBackupWithInventoryDataAndPhotoFiles}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF019;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.ImportWithPhotosFromZIP}"
                                Command="{Binding Backup.ImportFromZipCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseRestoreModeAndImportALocalZIPBackupWithPhotoFiles}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.ImportFromZIPFromFiles}"
                                Command="{Binding Backup.ImportZipFromFileSystemCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseRestoreModeAndImportAZIPBackupFromTheFileSystem}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF15B;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.ShareBackupZIP}"
                                Command="{Binding Backup.ShareZipCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseAndShareALocalBackupZIPFileOutsideTheApp}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="{x:Static strings:AppResources.DeleteBackupZIP}"
                                Command="{Binding Backup.DeleteZipCommand}"
                                                                SemanticProperties.Hint="{x:Static strings:AppResources.ChooseAndDeleteALocalBackupZIPFile}">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF2ED;" Size="16"
                                                                                                 Color="{DynamicResource OnPrimary}" />
                                                        </Button.ImageSource>
                                                </Button>
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding Backup.IsBusy}"
                                       IsVisible="{Binding Backup.IsBusy}"
                                       HorizontalOptions="Start"
                                       Color="{DynamicResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{DynamicResource OutlineVariant}"
                    StrokeShape="RoundRectangle 16"
                    Background="{DynamicResource SurfaceVariant}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static strings:AppResources.ImageProcessing}"
                           Style="{StaticResource HeadlineSmall}"
                           TextColor="{DynamicResource OnSurface}" />

                    <Label Text="{x:Static strings:AppResources.ViewActiveAndRecentBackgroundPhotoOperations}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{DynamicResource OnSurfaceVariant}" />

                    <Button Text="{x:Static strings:AppResources.ViewImageProcessing}"
                            Command="{Binding NavigateToBackgroundOperationsCommand}"
                                                        SemanticProperties.Hint="{x:Static strings:AppResources.OpenTheBackgroundPhotoOperationsPage}">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1C5;" Size="16"
                                                                                         Color="{DynamicResource OnPrimary}" />
                                                </Button.ImageSource>
                                        </Button>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
