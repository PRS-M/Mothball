<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.Features.Settings"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Shared"
                x:Class="MothballMobile.UI.Features.Settings.SettingsPage"
                x:DataType="vm:SettingsViewModel"
                Title="Settings"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <controls:PageHeader Title="Settings"
                                 Subtitle="Maintenance and backup"
                                 TitleFontSize="22"
                                 SubtitleFontSize="12"
                                 Spacing="2"
                                 HeaderMargin="0,0,0,6" />

                        <Border Padding="14"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                                        StrokeShape="RoundRectangle 16"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}">
                                <VerticalStackLayout Spacing="10">
                                        <Label Text="Theme"
                                                   Style="{StaticResource HeadlineSmall}"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                                        <Picker Title="Theme"
                                                        ItemsSource="{Binding ThemeOptions}"
                                                        SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}"
                                                        SemanticProperties.Hint="Choose automatic system theme, light theme, or dark theme" />

                                        <Label Text="Choose whether Mothball follows the system appearance or always uses a light or dark theme."
                                                   Style="{StaticResource BodyMedium}"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                </VerticalStackLayout>
                        </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                    StrokeShape="RoundRectangle 16"
                    Background="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="App Mode"
                               Style="{StaticResource HeadlineSmall}"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                        <Grid Grid.Column="1"
                              ColumnDefinitions="*,Auto,*"
                              ColumnSpacing="8"
                              HorizontalOptions="End"
                              VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Simple"
                                   Style="{StaticResource LabelSmall}"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsAdvancedAppMode, Mode=TwoWay}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Hint="Switch between simple mode and advanced mode" />
                            <Label Grid.Column="2"
                                   Text="Advanced&#10;(Default)"
                                   Style="{StaticResource LabelSmall}"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                        </Grid>
                    </Grid>

                    <Label Text="Advanced mode shows quantity totals, assignments, and quantity editing. Simple mode hides quantity management."
                           Style="{StaticResource BodyMedium}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                </VerticalStackLayout>
            </Border>

             <Border Padding="14"
                      StrokeThickness="1"
                      Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                      StrokeShape="RoundRectangle 16"
                      Background="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}">
                  <VerticalStackLayout Spacing="10">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                          <Label Text="Backup signing key"
                                 Style="{StaticResource HeadlineSmall}"
                                 VerticalOptions="Center"
                                 TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                          <Switch Grid.Column="1"
                                  IsToggled="{Binding IsBackupSigningKeyEnabled, Mode=TwoWay}"
                                  SemanticProperties.Hint="Enable or disable backup signing key use" />
                      </Grid>

                    <Label Text="When enabled, backups are signed with this device key. Share or import it to verify backups across devices."
                              Style="{StaticResource BodyMedium}"
                              TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />

                      <Button Text="Share signing key"
                                IsEnabled="{Binding IsBackupSigningKeyEnabled}"
                                Command="{Binding ShareBackupSigningKeyCommand}"
                                                                                                                                SemanticProperties.Hint="Share the backup signing key using the system share sheet, including AirDrop">
                                                                                                <Button.ImageSource>
                                                                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                                                                </Button.ImageSource>
                                                                                        </Button>

                    <Button Text="Import signing key"
                            Style="{StaticResource OutlinedButton}"
                            IsEnabled="{Binding IsBackupSigningKeyEnabled}"
                            Command="{Binding ImportBackupSigningKeyCommand}"
                                                        SemanticProperties.Hint="Import a backup signing key file received from another device">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                </Button.ImageSource>
                                        </Button>
                  </VerticalStackLayout>
             </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                    StrokeShape="RoundRectangle 16"
                    Background="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                          RowDefinitions="Auto">
                        <Label Grid.Column="0"
                               Text="Backup"
                               Style="{StaticResource HeadlineSmall}"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                        <Grid Grid.Column="1"
                              ColumnDefinitions="*,Auto,*"
                              ColumnSpacing="8"
                              HorizontalOptions="End"
                              VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="JSON&#10;(Metadata)"
                                   Style="{StaticResource LabelSmall}"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsZipBackupMode, Mode=TwoWay}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Hint="Switch between JSON metadata backups and ZIP backups with photos" />
                            <Label Grid.Column="2"
                                   Text="ZIP&#10;(with Photos)"
                                   Style="{StaticResource LabelSmall}"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                        </Grid>
                    </Grid>

                    <Label Text="Export inventory metadata as JSON, or create a ZIP backup that also includes photo files."
                           Style="{StaticResource BodyMedium}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />

                    <Button Text="Documentation / Help"
                            Style="{StaticResource OutlinedButton}"
                            Command="{Binding NavigateToImportDocumentationCommand}"
                                                        SemanticProperties.Hint="Open documentation that explains backup import modes">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF02D;" Size="16"
                                                                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                </Button.ImageSource>
                                        </Button>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsJsonBackupMode}">
                        <Button Text="Export to JSON"
                                Command="{Binding ExportToJsonCommand}"
                                                                SemanticProperties.Hint="Create a local backup JSON file with full inventory data">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF019;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import from JSON"
                                Command="{Binding ImportFromJsonCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a local backup JSON file">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import from JSON from files"
                                Command="{Binding ImportJsonFromFileSystemCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a JSON backup from the file system">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF15B;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Share backup JSON"
                                Command="{Binding ShareJsonCommand}"
                                                                SemanticProperties.Hint="Choose and share a local backup JSON file outside the app">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Delete backup JSON"
                                Command="{Binding DeleteJsonCommand}"
                                                                SemanticProperties.Hint="Choose and delete a local backup JSON file">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF2ED;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsZipBackupMode}">
                        <Button Text="Export with photos to ZIP"
                                Command="{Binding ExportToZipCommand}"
                                                                SemanticProperties.Hint="Create a local ZIP backup with inventory data and photo files">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF019;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import with photos from ZIP"
                                Command="{Binding ImportFromZipCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a local ZIP backup with photo files">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF093;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Import from ZIP from files"
                                Command="{Binding ImportZipFromFileSystemCommand}"
                                                                SemanticProperties.Hint="Choose restore mode and import a ZIP backup from the file system">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF15B;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Share backup ZIP"
                                Command="{Binding ShareZipCommand}"
                                                                SemanticProperties.Hint="Choose and share a local backup ZIP file outside the app">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1E0;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>

                        <Button Text="Delete backup ZIP"
                                Command="{Binding DeleteZipCommand}"
                                                                SemanticProperties.Hint="Choose and delete a local backup ZIP file">
                                                        <Button.ImageSource>
                                                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF2ED;" Size="16"
                                                                                                 Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                        </Button.ImageSource>
                                                </Button>
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Start"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}"
                    StrokeShape="RoundRectangle 16"
                    Background="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Image processing"
                           Style="{StaticResource HeadlineSmall}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                    <Label Text="View active and recent background photo operations."
                           Style="{StaticResource BodyMedium}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />

                    <Button Text="View image processing"
                            Command="{Binding NavigateToBackgroundOperationsCommand}"
                                                        SemanticProperties.Hint="Open the background photo operations page">
                                                <Button.ImageSource>
                                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xF1C5;" Size="16"
                                                                                         Color="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                </Button.ImageSource>
                                        </Button>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</views:BasePage>
