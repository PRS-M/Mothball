<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.ViewModels"
                xmlns:controls="clr-namespace:MothballMobile.UI.Controls"
                xmlns:views="clr-namespace:MothballMobile.UI.Views"
                x:Class="MothballMobile.UI.Views.AddItem"
                x:DataType="vm:AddItemViewModel"
                Title="Add Item"
                Background="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ScrollView>
        <Grid Padding="20"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="*">
            <controls:PageHeader Grid.Row="0"
                                 Title="Add a new item"
                                 Subtitle="Fill in the fields below"
                                 TitleFontSize="24"
                                 HeaderMargin="0,6,0,14" />

            <Border Grid.Row="1"
                    Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">
                    <controls:ValidatedTextField Label="Name"
                                                 WidthRequest="{StaticResource WidthM}"
                                                 Placeholder="Item name"
                                                 Text="{Binding Name}"
                                                 ReturnType="Done"
                                                 ReturnCommand="{Binding SaveCommand}"
                                                 ValidationMessage="{Binding ValidationMessage}" />

                    <controls:LabeledEntryField Label="Description"
                                               LabelMargin="4,8,4,0"
                                               FieldWidthRequest="{StaticResource WidthM}"
                                               WrapperStyle="{StaticResource InputWrapper}"
                                               Placeholder="Short description"
                                               Text="{Binding Description}" />

                    <controls:LabeledEntryField Label="Quantity"
                                               LabelMargin="4,8,4,0"
                                               FieldWidthRequest="{StaticResource WidthM}"
                                               WrapperStyle="{StaticResource InputWrapper}"
                                               Keyboard="Numeric"
                                               Placeholder="e.g. 1"
                                               Text="{Binding Quantity}" />

                    <Button Text="Choose Photo"
                            Style="{StaticResource OutlinedButton}"
                            WidthRequest="{StaticResource WidthM}"
                            Command="{Binding ChoosePhotoCommand}"/>

                    <Border Style="{StaticResource InputWrapper}"
                            WidthRequest="{StaticResource WidthM}"
                            IsVisible="{Binding IsPhotoProcessing}">
                           <VerticalStackLayout Spacing="8"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       MinimumHeightRequest="160">
                            <ActivityIndicator IsRunning="True"
                                         WidthRequest="32"
                                         HeightRequest="32"
                                         HorizontalOptions="Center" />
                            <Label Text="Resizing photo..."
                                Style="{StaticResource LabelSmall}"
                                HorizontalTextAlignment="Center" />
                           </VerticalStackLayout>
                          </Border>

                          <Border Style="{StaticResource InputWrapper}"
                            WidthRequest="{StaticResource WidthM}"
                            IsVisible="{Binding ShowPhotoThumbnail}">
                           <VerticalStackLayout Spacing="8"
                                       HorizontalOptions="Center">
                            <Image Source="{Binding PhotoThumbnailPath}"
                                HeightRequest="120"
                                WidthRequest="120"
                                Aspect="AspectFill" />
                            <Label Text="Photo selected"
                                Style="{StaticResource LabelSmall}"
                                HorizontalTextAlignment="Center" />
                           </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding PhotoSelectionStatus}"
                           Style="{StaticResource BodySmall}"
                           WidthRequest="{StaticResource WidthM}" />

                    <Button Text="Save Item"
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="{StaticResource WidthM}"
                            Command="{Binding SaveCommand}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</views:BasePage>