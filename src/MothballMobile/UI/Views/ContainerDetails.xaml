<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MothballMobile.UI.ViewModels"
                xmlns:maui="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
                xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                xmlns:conv="clr-namespace:MothballMobile.UI.Converters"
                xmlns:views="clr-namespace:MothballMobile.UI.Views"
                x:Class="MothballMobile.UI.Views.ContainerDetails"
                x:DataType="vm:ContainerDetailsViewModel"
                Title="Container"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Priority="0"
                     Order="Primary"
                     Command="{Binding DeleteContainerCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xF1F8;"
                                 Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                 Size="22"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <conv:PathToImageSourceConverter x:Key="PathToImage"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="0"
          Padding="0">
        <!-- Top: condensed container details -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="16,16,16,8"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="6">
                <Label Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="{Binding Name}"
                       FontSize="22"
                       FontAttributes="Bold"
                      TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"/>
                <Label Grid.Row="1"
                       Grid.Column="0"
                       Text="{Binding TotalItemCount, StringFormat='Items stored: {0}'}"
                      TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"/>
                <Label Grid.Row="2"
                       Grid.Column="0"
                       Text="{Binding Notes}"
                      TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                       FontSize="12"/>
                <Border Grid.RowSpan="3"
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 10"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                    <CarouselView ItemsSource="{Binding ContainerImagePaths}"
                                  HeightRequest="110"
                                  WidthRequest="110">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Image x:DataType="sys:String"
                                       Source="{Binding ., Converter={StaticResource PathToImage}}"
                                       Aspect="AspectFill"
                                       HeightRequest="110"
                                       WidthRequest="110">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="10"
                                                                Rect="0,0,110,110"/>
                                    </Image.Clip>
                                </Image>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                </Border>
            </Grid>
        </Border>

        <!-- Items header with buttons -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              VerticalOptions="Center"
              Margin="16,8,16,8">
            <Label Grid.Column="0"
                   Text="Items in this container"
                   FontSize="18"
                   FontAttributes="Bold"
                     TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                   VerticalOptions="Center"/>

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                <Button Text="Add a new item"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="36"
                        FontSize="12"
                        Padding="12,0"
                        Command="{Binding NavigateToAddNewItemCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid"
                                         Glyph="&#xF067;"
                                         Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                         Size="16"/>
                    </Button.ImageSource>
                </Button>
                <Button Text="Add an existing item"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="36"
                        FontSize="12"
                        Padding="12,0"
                        Command="{Binding NavigateToAddExistingItemCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid"
                                         Glyph="&#xF067;"
                                         Color="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                                         Size="16"/>
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>
        </Grid>

        <!-- Search bar -->
        <Border Grid.Row="2"
                Style="{StaticResource SearchWrapper}"
                Margin="16,0,16,16">
            <SearchBar x:DataType="vm:ContainerDetailsViewModel"
                       Placeholder="Search within container..."
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                       BackgroundColor="Transparent"
                       CancelButtonColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                       Text="{Binding SearchQuery}"
                       SearchCommand="{Binding ApplySearchCommand}"/>
        </Border>

        <!-- Items list with infinite scroll -->
        <CollectionView Grid.Row="3"
                        x:DataType="vm:ContainerDetailsViewModel"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreItemsCommand}"
                        Margin="16,0,16,16"
                        VerticalScrollBarVisibility="Default">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40"
                                     Spacing="10"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="No items in this container"
                              TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemWithPhotosViewModel">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="6">
                                <Border StrokeShape="RoundRectangle 10"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">
                                    <CarouselView ItemsSource="{Binding ImagePaths}"
                                                  HeightRequest="92"
                                                  WidthRequest="92">
                                        <CarouselView.ItemTemplate>
                                            <DataTemplate>
                                                <Image x:DataType="sys:String"
                                                       Source="{Binding ., Converter={StaticResource PathToImage}}"
                                                       Aspect="AspectFill"
                                                       HeightRequest="92"
                                                       WidthRequest="92">
                                                    <Image.Clip>
                                                        <RoundRectangleGeometry CornerRadius="10"
                                                                                Rect="0,0,92,92"/>
                                                    </Image.Clip>
                                                </Image>
                                            </DataTemplate>
                                        </CarouselView.ItemTemplate>
                                    </CarouselView>
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}"/>
                                <Label Text="{Binding Description}"
                                        TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:BasePage>