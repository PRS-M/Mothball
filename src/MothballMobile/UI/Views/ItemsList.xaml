<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MothballMobile.UI.ViewModels"
             x:Class="MothballMobile.UI.Views.ItemsList"
             x:DataType="vm:ItemsListViewModel"
             Title="Items"
             BackgroundColor="#0F172A">

    <Grid Padding="20" RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,10">
            <Label Text="Items" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource ColorPrimaryText}"/>
            <Label Text="All items across containers" TextColor="{StaticResource ColorMuted}"/>
        </VerticalStackLayout>

    <RefreshView Grid.Row="1"
              IsRefreshing="{Binding IsRefreshing}"
              Command="{Binding RefreshCommand}">
            <CollectionView
                ItemsSource="{Binding Items}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No items yet" TextColor="{StaticResource ColorMuted}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemViewModel">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Image Source="{Binding ImageSource}" Aspect="AspectFill" HeightRequest="72" WidthRequest="72">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="10" Rect="0,0,72,72"/>
                                    </Image.Clip>
                                </Image>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource ColorPrimaryText}"/>
                                    <Label Text="{Binding Description}" TextColor="{StaticResource ColorMuted}" FontSize="12" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>