<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Moq" />
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CoreApp/CoreApp.csproj" />
  </ItemGroup>

  <!-- Bring in UI-only Debouncer source directly for testability without MAUI target dependencies. -->
  <ItemGroup>
    <Compile Include="../../src/MothballMobile/Infrastructure/IDebouncer.cs" Link="Infrastructure/IDebouncer.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/Debouncer.cs" Link="Infrastructure/Debouncer.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/IBackgroundTaskObserver.cs" Link="Infrastructure/IBackgroundTaskObserver.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/LoggingBackgroundTaskObserver.cs" Link="Infrastructure/LoggingBackgroundTaskObserver.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/TaskExtensions.cs" Link="Infrastructure/TaskExtensions.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/IPopupService.cs" Link="Infrastructure/IPopupService.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/INavigationService.cs" Link="Infrastructure/INavigationService.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/NavigationParams.cs" Link="Infrastructure/NavigationParams.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/NavigationRoutes.cs" Link="Infrastructure/NavigationRoutes.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/IPhotoBackgroundOperationTracker.cs" Link="Infrastructure/IPhotoBackgroundOperationTracker.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/PhotoBackgroundOperationEntry.cs" Link="Infrastructure/PhotoBackgroundOperationEntry.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/Popups/**/*.cs" Link="Infrastructure/Popups/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/MothballMobile/Infrastructure/IRetryService.cs" Link="Infrastructure/IRetryService.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/RetryService.cs" Link="Infrastructure/RetryService.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/IAppStartupOrchestrator.cs" Link="Infrastructure/IAppStartupOrchestrator.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/AppStartupOrchestrator.cs" Link="Infrastructure/AppStartupOrchestrator.cs" />
    <Compile Include="../../src/MothballMobile/Infrastructure/IInitializable.cs" Link="Infrastructure/IInitializable.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/MothballMobile/UI/Shared/BaseViewModel.cs" Link="UI/Shared/BaseViewModel.cs" />
    <Compile Include="../../src/MothballMobile/UI/Shared/PagedListViewModelBase.cs" Link="UI/Shared/PagedListViewModelBase.cs" />
    <Compile Include="../../src/MothballMobile/UI/Shared/ContainerWithImagesViewModelBase.cs" Link="UI/Shared/ContainerWithImagesViewModelBase.cs" />
    <Compile Include="../../src/MothballMobile/UI/Shared/PhotoDetailsViewModelBase.cs" Link="UI/Shared/PhotoDetailsViewModelBase.cs" />
    <Compile Include="../../src/MothballMobile/UI/Shared/PhotoSourceSelector.cs" Link="UI/Shared/PhotoSourceSelector.cs" />
    <Compile Include="../../src/MothballMobile/UI/Features/Items/ItemDetails/ItemDetailsViewModel.cs" Link="UI/Features/Items/ItemDetails/ItemDetailsViewModel.cs" />
    <Compile Include="../../src/MothballMobile/UI/Features/Containers/AssociateItemWithContainer/AssociateItemWithContainerViewModel.cs" Link="UI/Features/Containers/AssociateItemWithContainer/AssociateItemWithContainerViewModel.cs" />
    <Compile Include="../../src/MothballMobile/UI/Features/Containers/AssociateItemWithContainer/SelectableContainerViewModel.cs" Link="UI/Features/Containers/AssociateItemWithContainer/SelectableContainerViewModel.cs" />
  </ItemGroup>

  <!-- Compile non-MAUI Infrastructure sources directly to avoid referencing the MAUI-only Infrastructure project. -->
  <ItemGroup>
    <Compile Include="../../src/Infrastructure/DatabaseModels/**/*.cs" Link="Infrastructure/DatabaseModels/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Infrastructure/Interfaces/**/*.cs" Link="Infrastructure/Interfaces/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Infrastructure/Mappers/**/*.cs" Link="Infrastructure/Mappers/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Infrastructure/Services/DemoDataSeeder.cs" Link="Infrastructure/Services/DemoDataSeeder.cs" />
    <Compile Include="../../src/Infrastructure/Services/ImagePathResolver.cs" Link="Infrastructure/Services/ImagePathResolver.cs" />
    <Compile Include="../../src/Infrastructure/Services/MothballDatabase.cs" Link="Infrastructure/Services/MothballDatabase.cs" />
    <Compile Include="../../src/Infrastructure/Services/SqliteStartupInitializer.cs" Link="Infrastructure/Services/SqliteStartupInitializer.cs" />
    <Compile Include="../../src/Infrastructure/Services/Restore/**/*.cs" Link="Infrastructure/Services/Restore/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Infrastructure/Services/JsonStore/**/*.cs" Link="Infrastructure/Services/JsonStore/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Infrastructure/Services/Repositories/**/*.cs" Link="Infrastructure/Services/Repositories/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
